{
  "@context": [
    "https://www.w3.org/ns/solid/oidc-context.jsonld",
    {
      "fedapp": "https://jeswr.org/ns/fed#",
      "acl": "http://www.w3.org/ns/auth/acl#",
      "sector": {
        "@id": "fedapp:sector",
        "@type": "@id"
      },
      "access": {
        "@id": "fedapp:access",
        "@type": "@id"
      },
      "produces": {
        "@id": "fedapp:produces",
        "@type": "@id"
      },
      "consumes": {
        "@id": "fedapp:consumes",
        "@type": "@id"
      }
    }
  ],
  "client_id": "https://pod-docs.jeswr.org/clientid.jsonld",
  "client_name": "Pod Docs",
  "client_uri": "https://pod-docs.jeswr.org/",
  "redirect_uris": [
    "https://pod-docs.jeswr.org/callback"
  ],
  "scope": "openid webid offline_access",
  "grant_types": [
    "authorization_code",
    "refresh_token"
  ],
  "response_types": [
    "code"
  ],
  "token_endpoint_auth_method": "none",
  "sector": "https://jeswr.org/ns/sectors/documents#sector",
  "access": [
    "acl:Read",
    "acl:Write",
    "acl:Append"
  ],
  "produces": [
    "https://jeswr.org/ns/pod-docs#Document"
  ],
  "consumes": [
    "https://jeswr.org/ns/pod-docs#Document"
  ],
  "@type": "fedapp:App"
}
