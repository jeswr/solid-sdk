{
  "name": "@jeswr/app-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @jeswr/suite-ui run build && next dev --webpack -p 3210",
    "build": "next build --webpack",
    "start": "next start -p 3210",
    "lint": "biome check src test e2e *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "pnpm --filter @jeswr/suite-ui run build && playwright test",
    "measure:univer": "node test/univer-spike.measure.mjs",
    "test:mime": "vitest run test/mime.test.ts --coverage",
    "test:coverage": "vitest run --coverage",
    "coverage:music": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.4.0",
    "@jeswr/fetch-rdf": "workspace:*",
    "@jeswr/guarded-fetch": "workspace:*",
    "@jeswr/pod-connectors": "workspace:*",
    "@jeswr/rdf-serialize": "workspace:*",
    "@jeswr/solid-chat-interop": "workspace:*",
    "@jeswr/solid-dav-bridge": "workspace:*",
    "@jeswr/solid-task-model": "workspace:*",
    "@jeswr/suite-ui": "workspace:*",
    "@jeswr/suite-vocab": "workspace:*",
    "@rdfjs/wrapper": "0.34.0",
    "@solid/object": "0.6.0",
    "@univerjs/core": "1.2.0",
    "@univerjs/sheets": "1.2.0",
    "chrono-node": "^2.10.3",
    "exifr": "^7.1.3",
    "jsonld-streaming-serializer": "^4.0.0",
    "lucide-react": "1.24.0",
    "marked": "17.0.6",
    "music-metadata": "12.3.2",
    "n3": "2.0.3",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "postal-mime": "4.1.4",
    "rdf-isomorphic": "2.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "rrule": "2.8.1",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "saxes": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "1.61.1",
    "@rdfjs/types": "2.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/n3": "1.26.1",
    "@types/node": "^25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
