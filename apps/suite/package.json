{
  "name": "@jeswr/app-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @jeswr/suite-ui run build && next dev --webpack -p 3210",
    "build": "next build --webpack",
    "start": "next start -p 3210",
    "lint": "biome check src test e2e *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "pnpm --filter @jeswr/suite-ui run build && playwright test"
  },
  "dependencies": {
    "@jeswr/suite-ui": "workspace:*",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@jeswr/suite-vocab": "workspace:*",
    "@jeswr/guarded-fetch": "workspace:*",
    "@jeswr/fetch-rdf": "0.1.0",
    "@rdfjs/wrapper": "0.34.0",
    "@solid/object": "0.6.0",
    "n3": "2.0.3",
    "saxes": "6.0.0",
    "@jeswr/rdf-serialize": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "@playwright/test": "1.61.1",
    "@axe-core/playwright": "^4.11.1",
    "@types/node": "^25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "@biomejs/biome": "^2.5.1",
    "@rdfjs/types": "2.0.1",
    "@types/n3": "1.26.1",
    "@vitest/coverage-v8": "^4.1.10"
  }
}
