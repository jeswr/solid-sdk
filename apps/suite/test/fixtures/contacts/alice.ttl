# AUTHORED-BY Codex GPT-6.1-Sol
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
<#this> a vcard:Individual; vcard:fn "Alice";
  vcard:inAddressBook <../book.ttl#this>;
  vcard:hasUID "urn:uuid:alice";
  dct:created "2026-01-01T12:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>;
  vcard:hasEmail [ a vcard:Work; vcard:value <mailto:alice@example.org> ];
  vcard:hasTelephone [ a vcard:Cell; vcard:value <tel:+441234567> ];
  vcard:url [ a vcard:WebId; vcard:value <https://alice.example/profile#me> ];
  vcard:organization-name "Example Ltd"; vcard:note "Met at Solid";
  <https://example.org/custom> "Preserve me" .
