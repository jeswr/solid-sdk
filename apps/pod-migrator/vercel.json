{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@jeswr/app-pod-migrator",
  "outputDirectory": "dist",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs @jeswr/app-pod-migrator",
  "rewrites": [{ "source": "/((?!assets/|.*\\.[^/]+$).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/clientid.jsonld",
      "headers": [
        { "key": "Content-Type", "value": "application/ld+json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
