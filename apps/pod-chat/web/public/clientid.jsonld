{
  "@context": [
    "https://www.w3.org/ns/solid/oidc-context.jsonld"
  ],
  "client_id": "https://solid-pod-chat.vercel.app/clientid.jsonld",
  "client_name": "Pod Chat",
  "client_uri": "https://solid-pod-chat.vercel.app/",
  "redirect_uris": [
    "https://solid-pod-chat.vercel.app/callback.html",
    "https://solid-pod-chat.vercel.app/"
  ],
  "scope": "openid webid offline_access",
  "grant_types": [
    "authorization_code",
    "refresh_token"
  ],
  "response_types": [
    "code"
  ],
  "token_endpoint_auth_method": "none"
}
