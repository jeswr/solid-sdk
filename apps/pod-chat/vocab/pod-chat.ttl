# AUTHORED-BY Codex GPT-6.1-Sol
@prefix pc: <https://jeswr.org/ns/pod-chat#> .
@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .

<https://jeswr.org/ns/pod-chat> a owl:Ontology ;
    rdfs:label "Pod Chat vocabulary" ;
    vann:preferredNamespacePrefix "pc" ;
    vann:preferredNamespaceUri "https://jeswr.org/ns/pod-chat#" .

pc:ChatRoom a owl:Class ;
    rdfs:label "Chat room" ;
    rdfs:subClassOf as:Collection ;
    rdfs:comment "A chat room whose message resources are indexed by as:items." .

pc:participant a owl:ObjectProperty ;
    rdfs:label "participant" ;
    rdfs:domain pc:ChatRoom ;
    rdfs:range as:Person ;
    rdfs:comment "Links a chat room to a participant identified by their WebID." .
