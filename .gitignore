# Dependencies — one pnpm store, never committed
node_modules/
.pnpm-store/
.turbo/

# Built output is NOT committed in the monorepo (ADR 0001 §4.4):
# the per-package mirror repos carry dist/; here it is always built fresh.
dist/

coverage/
*.tsbuildinfo
*.log
.vitest/
.DS_Store

# Playwright screenshots / traces written by lanes and e2e runs
/artifacts/

# Docs browser captures are local verification artifacts
/apps/suite/e2e/screenshots/
