# AUTHORED-BY Claude Sonnet 5.5
#
# Generation INPUT for @jeswr/solid-creative-assets; not published and not an ontology.
#
# Mints nothing. Every IRI below is a schema.org (https://schema.org/) or PROV-O
# (http://www.w3.org/ns/prov#) term. The labels and comments only satisfy the generator's
# admission, and every property states rdfs:domain and rdfs:range rdfs:Resource, which
# asserts nothing about the real terms. The schema.org classes are declared owl:Class
# because the generator needs exactly one declared class to pick the canonical type when
# a shape also lists the legacy http://schema.org/ alias.

@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .

# --- Classes ---

schema:ImageObject a owl:Class ;
    rdfs:label "ImageObject"@en ;
    rdfs:comment "An image file; here an AI-generated image or a thumbnail of an asset."@en .
schema:VideoObject a owl:Class ;
    rdfs:label "VideoObject"@en ;
    rdfs:comment "A video file; here an AI-generated video."@en .
schema:3DModel a owl:Class ;
    rdfs:label "3DModel"@en ;
    rdfs:comment "A 3D model file; here a mesh or a gaussian splat, told apart by its encoding format."@en .
schema:CreativeWork a owl:Class ;
    rdfs:label "CreativeWork"@en ;
    rdfs:comment "A creative work; here a project document (scene, timeline, board) or the prompt text of a generation run."@en .
schema:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    rdfs:comment "A group of assets, such as a folder."@en .
schema:SoftwareApplication a owl:Class ;
    rdfs:label "SoftwareApplication"@en ;
    rdfs:comment "A software application; here the AI model that produced an asset."@en .
schema:PropertyValue a owl:Class ;
    rdfs:label "PropertyValue"@en ;
    rdfs:comment "A property-value pair; here one generation setting such as a seed."@en .
prov:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "Something that occurs over time and acts on entities; here a generation run."@en .

# --- Properties ---

schema:name a owl:DatatypeProperty ; rdfs:label "name"@en ;
    rdfs:comment "The name of the item."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:description a owl:DatatypeProperty ; rdfs:label "description"@en ;
    rdfs:comment "A short description of the item."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:contentUrl a owl:ObjectProperty ; rdfs:label "contentUrl"@en ;
    rdfs:comment "The actual bytes of the media or document object, as a URL."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:encodingFormat a owl:DatatypeProperty ; rdfs:label "encodingFormat"@en ;
    rdfs:comment "The media type of the content, such as image/png."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:width a owl:DatatypeProperty ; rdfs:label "width"@en ;
    rdfs:comment "The width in pixels."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:height a owl:DatatypeProperty ; rdfs:label "height"@en ;
    rdfs:comment "The height in pixels."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:contentSize a owl:DatatypeProperty ; rdfs:label "contentSize"@en ;
    rdfs:comment "The size of the content as text, such as 1.2 MB."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:dateCreated a owl:DatatypeProperty ; rdfs:label "dateCreated"@en ;
    rdfs:comment "When the item was created."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:dateModified a owl:DatatypeProperty ; rdfs:label "dateModified"@en ;
    rdfs:comment "When the item was last modified."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:keywords a owl:DatatypeProperty ; rdfs:label "keywords"@en ;
    rdfs:comment "A tag or keyword; one literal per keyword."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:thumbnail a owl:ObjectProperty ; rdfs:label "thumbnail"@en ;
    rdfs:comment "A smaller image that represents the item."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:creator a owl:ObjectProperty ; rdfs:label "creator"@en ;
    rdfs:comment "The person who made the item, as a WebID."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:isBasedOn a owl:ObjectProperty ; rdfs:label "isBasedOn"@en ;
    rdfs:comment "A resource the item was made from."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:duration a owl:DatatypeProperty ; rdfs:label "duration"@en ;
    rdfs:comment "The length of the video as an ISO 8601 duration."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:text a owl:DatatypeProperty ; rdfs:label "text"@en ;
    rdfs:comment "The textual content of a creative work, here the prompt."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:schemaVersion a owl:DatatypeProperty ; rdfs:label "schemaVersion"@en ;
    rdfs:comment "The version of the document format."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:additionalType a owl:DatatypeProperty ; rdfs:label "additionalType"@en ;
    rdfs:comment "A further type of the item; here the project kind, such as scene_3d."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:hasPart a owl:ObjectProperty ; rdfs:label "hasPart"@en ;
    rdfs:comment "A part of the item."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:identifier a owl:DatatypeProperty ; rdfs:label "identifier"@en ;
    rdfs:comment "An identifier; here the provider's model id."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:softwareVersion a owl:DatatypeProperty ; rdfs:label "softwareVersion"@en ;
    rdfs:comment "The version of the software."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:provider a owl:ObjectProperty ; rdfs:label "provider"@en ;
    rdfs:comment "The organisation that provides the software, as an IRI."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:propertyID a owl:DatatypeProperty ; rdfs:label "propertyID"@en ;
    rdfs:comment "The name of the property, such as seed."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
schema:value a owl:DatatypeProperty ; rdfs:label "value"@en ;
    rdfs:comment "The value, kept as text because a 64-bit seed does not fit a JavaScript number."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
prov:wasGeneratedBy a owl:ObjectProperty ; rdfs:label "wasGeneratedBy"@en ;
    rdfs:comment "The run that generated the asset."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
prov:wasDerivedFrom a owl:ObjectProperty ; rdfs:label "wasDerivedFrom"@en ;
    rdfs:comment "A source asset the asset was derived from."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
prov:startedAtTime a owl:DatatypeProperty ; rdfs:label "startedAtTime"@en ;
    rdfs:comment "When the run started."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
prov:endedAtTime a owl:DatatypeProperty ; rdfs:label "endedAtTime"@en ;
    rdfs:comment "When the run ended."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
prov:used a owl:ObjectProperty ; rdfs:label "used"@en ;
    rdfs:comment "An input of the run: the prompt, a source asset or a setting."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
prov:wasAssociatedWith a owl:ObjectProperty ; rdfs:label "wasAssociatedWith"@en ;
    rdfs:comment "An agent responsible for the run: the model or the user."@en ;
    rdfs:domain rdfs:Resource ; rdfs:range rdfs:Resource .
