    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:height ;
    sh:name "height" ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:contentSize ;
    sh:name "contentSize" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:dateCreated ;
    sh:name "dateCreated" ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:keywords ;
    sh:name "keywords" ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path schema:thumbnail ;
    sh:name "thumbnail" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:creator ;
    sh:name "creator" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prov:wasGeneratedBy ;
    sh:name "wasGeneratedBy" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:name "wasDerivedFrom" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
  ] ;
  sh:property [
    sh:path schema:isBasedOn ;
    sh:name "isBasedOn" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
  ] ;
  sh:property [
    sh:path schema:duration ;
    sh:name "duration" ;
    sh:datatype xsd:duration ;
    sh:maxCount 1 ;
  ] .

[] a sh:NodeShape ;
  sh:targetClass schema:3DModel, hschema:3DModel ;
  sh:property [
    sh:path schema:name ;
    sh:name "name" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:description ;
    sh:name "description" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:contentUrl ;
    sh:name "contentUrl" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:encodingFormat ;
    sh:name "encodingFormat" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:contentSize ;
    sh:name "contentSize" ;
    sh:datatype xsd:string ;
