[] a sh:NodeShape ;
  sh:targetClass schema:CreativeWork, hschema:CreativeWork ;
  sh:property [
    sh:path schema:name ;
    sh:name "name" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:text ;
    sh:name "text" ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
    sh:pattern "\\S" ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:contentUrl ;
    sh:name "contentUrl" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:encodingFormat ;
    sh:name "encodingFormat" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:schemaVersion ;
    sh:name "schemaVersion" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:additionalType ;
    sh:name "additionalType" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:hasPart ;
    sh:name "hasPart" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
  ] ;
  sh:property [
    sh:path schema:dateCreated ;
    sh:name "dateCreated" ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:dateModified ;
    sh:name "dateModified" ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:creator ;
    sh:name "creator" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    sh:maxCount 1 ;
  ] .

[] a sh:NodeShape ;
  sh:targetClass schema:Collection, hschema:Collection ;
  sh:property [
    sh:path schema:name ;
    sh:name "name" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:hasPart ;
    sh:name "hasPart" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
  ] ;
  sh:property [
    sh:path schema:dateCreated ;
    sh:name "dateCreated" ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
  ] .

[] a sh:NodeShape ;
  sh:targetClass schema:SoftwareApplication, hschema:SoftwareApplication ;
  sh:property [
    sh:path schema:name ;
    sh:name "name" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:identifier ;
    sh:name "identifier" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:softwareVersion ;
    sh:name "softwareVersion" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:provider ;
    sh:name "provider" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    sh:maxCount 1 ;
  ] .

[] a sh:NodeShape ;
  sh:targetClass schema:PropertyValue, hschema:PropertyValue ;
  sh:property [
    sh:path schema:propertyID ;
    sh:name "propertyID" ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
    sh:pattern "\\S" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:value ;
    sh:name "settingValue" ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
    sh:pattern "\\S" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] .

[] a sh:NodeShape ;
  sh:targetClass prov:Activity ;
  sh:property [
    sh:path prov:startedAtTime ;
    sh:name "startedAtTime" ;
