    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prov:endedAtTime ;
    sh:name "endedAtTime" ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path prov:used ;
    sh:name "used" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
  ] ;
  sh:property [
    sh:path prov:wasAssociatedWith ;
    sh:name "wasAssociatedWith" ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
  ] .
