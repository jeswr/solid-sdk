{
  "name": "@jeswr/solid-chat-interop",
  "version": "0.0.1",
  "description": "Chat/conversation interop reconciler \u2014 maps between ActivityStreams 2.0 (the suite's canonical chat write model), SolidOS meeting:LongChat (the installed-base read), and an external-schema adapter seam (LibreChat as proof). Pure-RDF, non-server-touching, typed accessors only.",
  "type": "module",
  "license": "MIT",
  "securityCritical": true,
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/solid-chat-interop.git"
  },
  "homepage": "https://github.com/jeswr/solid-chat-interop#readme",
  "bugs": {
    "url": "https://github.com/jeswr/solid-chat-interop/issues"
  },
  "keywords": [
    "solid",
    "rdf",
    "chat",
    "activitystreams",
    "as2",
    "longchat",
    "solidos",
    "librechat",
    "interop",
    "reconciler"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./shape": {
      "types": "./dist/shape.d.ts",
      "import": "./dist/shape.js"
    },
    "./shapes/message.shacl.ttl": "./shapes/message.shacl.ttl"
  },
  "files": [
    "dist",
    "shapes",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "codegen": "node node_modules/@jeswr/federation-codegen/dist/cli.js gen --ontology codegen/chat.ontology.ttl --shapes codegen/chat.shapes.ttl --config codegen/codegen.config.json --out src/generated",
    "lint": "biome check src scripts test codegen/codegen.config.json package.json",
    "lint:fix": "biome check --write src scripts test codegen/codegen.config.json package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jeswr/fetch-rdf": "workspace:*",
    "@jeswr/model-runtime": "workspace:*",
    "@jeswr/rdf-serialize": "workspace:*",
    "@jeswr/solid-task-model": "workspace:*",
    "@rdfjs/wrapper": "^0.34.0",
    "@solid/object": "^0.6.0",
    "n3": "^2.0.3",
    "@jeswr/suite-vocab": "workspace:*"
  },
  "peerDependencies": {
    "@rdfjs/types": "^2.0.1"
  },
  "mirrorPublish": {
    "inlined": [
      "@jeswr/model-runtime",
      "@jeswr/suite-vocab"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@jeswr/federation-codegen": "workspace:*",
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.1",
    "@types/node": "^20",
    "esbuild": "^0.28.1",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "@jeswr/rdf-engine": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
