{
  "name": "@jeswr/agent-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Host-only encrypted credentials, account routing and sessions for the agent browser.",
  "type": "module",
  "license": "MIT",
  "x-authored-by": "Codex GPT-6.1-Sol",
  "securityCritical": true,
  "sideEffects": false,
  "bin": {
    "agent-vault-native": "./dist/native-cli.js",
    "agent-vault-native-manifest": "./scripts/native-manifest.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./native-host": {
      "types": "./dist/native-host.d.ts",
      "default": "./dist/native-host.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "lint": "pnpm -w exec biome check packages/agent-vault",
    "build": "pnpm -w exec tsc -p packages/agent-vault/tsconfig.json",
    "typecheck": "pnpm -w exec tsc -p packages/agent-vault/tsconfig.json --noEmit && pnpm -w exec tsc -p packages/agent-vault/tsconfig.test.json",
    "test": "pnpm -w exec vitest run --root packages/agent-vault"
  },
  "dependencies": {
    "@jeswr/agent-credentials": "workspace:*",
    "@jeswr/guarded-fetch": "workspace:*",
    "@jeswr/site-executor": "workspace:*",
    "@jeswr/site-model": "workspace:*",
    "n3": "^2.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/n3": "^1.26.1"
  }
}
