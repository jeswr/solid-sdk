{
  "manifestVersion": 1,
  "runtime": {
    "name": "@jeswr/model-runtime",
    "major": 0
  },
  "prefixes": {
    "schema": "http://schema.org/",
    "dct": "http://purl.org/dc/terms/"
  },
  "entities": [
    {
      "name": "Template",
      "typeIris": [
        "https://jeswr.org/ns/templates#Template"
      ],
      "subject": {
        "convention": "hash-it"
      },
      "fields": [
        {
          "name": "created",
          "predicate": "http://purl.org/dc/terms/created",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#dateTime",
          "maxCount": 1,
          "guards": {}
        },
        {
          "name": "author",
          "predicate": "http://purl.org/dc/terms/creator",
          "kind": "iri",
          "maxCount": 1,
          "guards": {
            "iriScheme": "http-https",
            "iriPattern": "http-https"
          }
        },
        {
          "name": "modified",
          "predicate": "http://purl.org/dc/terms/modified",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#dateTime",
          "maxCount": 1,
          "guards": {}
        },
        {
          "name": "app",
          "predicate": "http://schema.org/about",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "minCount": 1,
          "maxCount": 1,
          "in": [
            "docs",
            "sheets",
            "notes",
            "tasks"
          ],
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "description",
          "predicate": "http://schema.org/description",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "maxCount": 1,
          "guards": {}
        },
        {
          "name": "category",
          "predicate": "http://schema.org/genre",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true,
            "nonBlank": true
          }
        },
        {
          "name": "previewImage",
          "predicate": "http://schema.org/image",
          "kind": "iri",
          "maxCount": 1,
          "guards": {
            "iriScheme": "http-https",
            "iriPattern": "http-https"
          }
        },
        {
          "name": "name",
          "predicate": "http://schema.org/name",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true,
            "nonBlank": true
          }
        },
        {
          "name": "previewText",
          "predicate": "http://schema.org/text",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "maxCount": 1,
          "guards": {}
        },
        {
          "name": "content",
          "predicate": "http://schema.org/url",
          "kind": "iri",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "iriScheme": "http-https",
            "iriPattern": "http-https",
            "requiredFailClosed": true
          }
        }
      ]
    }
  ]
}
