# AUTHORED-BY Codex (GPT-6.1 Sol)
@prefix log: <https://jeswr.org/ns/media-log#> .
@prefix media: <https://jeswr.org/ns/sectors/media#> .
@prefix core: <https://jeswr.org/ns/core#> .
@prefix schema: <https://schema.org/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Minimal projection of the canonical media sector, plus a personal record extension.
<https://jeswr.org/ns/media-log> a owl:Ontology .
log:LogEntry a owl:Class ; rdfs:subClassOf core:Record ; rdfs:label "Media log entry"@en ; skos:definition "A person's shelf, progress and reflection about one creative work."@en .
media:CreativeWork a owl:Class ; rdfs:subClassOf core:InformationResource, core:Asset ; rdfs:label "Creative Work"@en ; skos:definition "A work of authorship — a recording, album, podcast episode, video, or other media item. An information object that, when licensable, is also a core:Asset. Aligns to schema:CreativeWork."@en .
core:about a owl:ObjectProperty ; rdfs:domain log:LogEntry ; rdfs:range media:CreativeWork ; rdfs:label "work"@en ; skos:definition "The work described by this record."@en .
dct:title a owl:DatatypeProperty ; rdfs:domain media:CreativeWork ; rdfs:range xsd:string ; rdfs:label "title"@en ; skos:definition "The title of the work."@en .
schema:additionalType a owl:ObjectProperty ; rdfs:domain media:CreativeWork ; rdfs:range rdfs:Class ; rdfs:label "kind"@en ; skos:definition "The schema.org work kind, also asserted as a type when writing."@en .
dc:creator a owl:DatatypeProperty ; rdfs:domain media:CreativeWork ; rdfs:range xsd:string ; rdfs:label "creator"@en ; skos:definition "The credited creator display name."@en .
dct:issued a owl:DatatypeProperty ; rdfs:domain media:CreativeWork ; rdfs:range xsd:integer ; rdfs:label "year"@en ; skos:definition "The release or publication year."@en .
schema:image a owl:ObjectProperty ; rdfs:domain media:CreativeWork ; rdfs:range rdfs:Resource ; rdfs:label "cover"@en ; skos:definition "An optional cover image URL."@en .
log:status a owl:DatatypeProperty ; rdfs:domain log:LogEntry ; rdfs:range xsd:string ; rdfs:label "status"@en ; skos:definition "The personal consumption shelf, independent of publication status."@en .
schema:startDate a owl:DatatypeProperty ; rdfs:domain log:LogEntry ; rdfs:range xsd:date ; rdfs:label "started"@en ; skos:definition "The date consumption began."@en .
schema:endDate a owl:DatatypeProperty ; rdfs:domain log:LogEntry ; rdfs:range xsd:date ; rdfs:label "finished"@en ; skos:definition "The most recent completion date."@en .
schema:ratingValue a owl:DatatypeProperty ; rdfs:domain log:LogEntry ; rdfs:range xsd:decimal ; rdfs:label "rating"@en ; skos:definition "Personal rating on a half-star to five-star scale."@en .
schema:reviewBody a owl:DatatypeProperty ; rdfs:domain log:LogEntry ; rdfs:range xsd:string ; rdfs:label "review"@en ; skos:definition "Personal review text."@en .
log:repeatCount a owl:DatatypeProperty ; rdfs:domain log:LogEntry ; rdfs:range xsd:integer ; rdfs:label "repeat count"@en ; skos:definition "Additional completions after the first watch, read or play."@en .
log:progress a owl:DatatypeProperty ; rdfs:domain log:LogEntry ; rdfs:range xsd:integer ; rdfs:label "progress"@en ; skos:definition "Current page or episode reached."@en .
log:progressUnit a owl:DatatypeProperty ; rdfs:domain log:LogEntry ; rdfs:range xsd:string ; rdfs:label "progress unit"@en ; skos:definition "Whether progress counts pages or episodes."@en .
dct:source a owl:DatatypeProperty ; rdfs:domain log:LogEntry ; rdfs:range xsd:string ; rdfs:label "source"@en ; skos:definition "The import origin, or Manual."@en .
prov:wasDerivedFrom a owl:ObjectProperty ; rdfs:domain log:LogEntry ; rdfs:range rdfs:Resource ; rdfs:label "origin"@en ; skos:definition "The imported source subject or canonical external item URL."@en .
