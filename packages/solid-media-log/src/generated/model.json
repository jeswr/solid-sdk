{
  "manifestVersion": 1,
  "runtime": {
    "name": "@jeswr/model-runtime",
    "major": 0
  },
  "prefixes": {
    "log": "https://jeswr.org/ns/media-log#",
    "media": "https://jeswr.org/ns/sectors/media#",
    "core": "https://jeswr.org/ns/core#",
    "schema": "https://schema.org/",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "prov": "http://www.w3.org/ns/prov#",
    "dc": "http://purl.org/dc/elements/1.1/"
  },
  "entities": [
    {
      "name": "MediaLog",
      "kind": "composite",
      "root": "entry",
      "nodes": [
        {
          "name": "entry",
          "typeIris": [
            "https://jeswr.org/ns/media-log#LogEntry"
          ],
          "fragment": "it",
          "fields": [
            {
              "name": "source",
              "predicate": "http://purl.org/dc/terms/source",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#string",
              "maxCount": 1,
              "guards": {}
            },
            {
              "name": "origin",
              "predicate": "http://www.w3.org/ns/prov#wasDerivedFrom",
              "kind": "iri",
              "maxCount": 1,
              "guards": {
                "iriScheme": "http-https",
                "iriPattern": "http-https"
              }
            },
            {
              "name": "about",
              "predicate": "https://jeswr.org/ns/core#about",
              "kind": "nested",
              "node": "work",
              "minCount": 1,
              "hasClass": "https://jeswr.org/ns/sectors/media#CreativeWork",
              "classOnly": true,
              "guards": {
                "requiredFailClosed": true
              }
            },
            {
              "name": "progress",
              "predicate": "https://jeswr.org/ns/media-log#progress",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#integer",
              "maxCount": 1,
              "guards": {
                "minInclusive": 0
              }
            },
            {
              "name": "progressUnit",
              "predicate": "https://jeswr.org/ns/media-log#progressUnit",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#string",
              "maxCount": 1,
              "in": [
                "page",
                "episode"
              ],
              "guards": {}
            },
            {
              "name": "repeatCount",
              "predicate": "https://jeswr.org/ns/media-log#repeatCount",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#integer",
              "maxCount": 1,
              "guards": {
                "minInclusive": 0
              }
            },
            {
              "name": "status",
              "predicate": "https://jeswr.org/ns/media-log#status",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#string",
              "minCount": 1,
              "maxCount": 1,
              "in": [
                "want",
                "in-progress",
                "finished",
                "abandoned"
              ],
              "guards": {
                "requiredFailClosed": true
              }
            },
            {
              "name": "finished",
              "predicate": "https://schema.org/endDate",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#date",
              "maxCount": 1,
              "guards": {}
            },
            {
              "name": "rating",
              "predicate": "https://schema.org/ratingValue",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#decimal",
              "maxCount": 1,
              "in": [
                0.5,
                1,
                1.5,
                2,
                2.5,
                3,
                3.5,
                4,
                4.5,
                5
              ],
              "guards": {}
            },
            {
              "name": "review",
              "predicate": "https://schema.org/reviewBody",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#string",
              "maxCount": 1,
              "guards": {}
            },
            {
              "name": "started",
              "predicate": "https://schema.org/startDate",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#date",
              "maxCount": 1,
              "guards": {}
            }
          ]
        },
        {
          "name": "work",
          "typeIris": [
            "https://jeswr.org/ns/sectors/media#CreativeWork"
          ],
          "fragment": "work",
          "fields": [
            {
              "name": "creator",
              "predicate": "http://purl.org/dc/elements/1.1/creator",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#string",
              "maxCount": 1,
              "guards": {}
            },
            {
              "name": "year",
              "predicate": "http://purl.org/dc/terms/issued",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#integer",
              "maxCount": 1,
              "guards": {
                "minInclusive": 1000,
                "maxInclusive": 9999
              }
            },
            {
              "name": "title",
              "predicate": "http://purl.org/dc/terms/title",
              "kind": "literal",
              "datatype": "http://www.w3.org/2001/XMLSchema#string",
              "minCount": 1,
              "maxCount": 1,
              "guards": {
                "requiredFailClosed": true,
                "minLength": 1,
                "nonBlank": true
              }
            },
            {
              "name": "workType",
              "predicate": "https://schema.org/additionalType",
              "kind": "iri",
              "minCount": 1,
              "maxCount": 1,
              "in": [
                "https://schema.org/Movie",
                "https://schema.org/TVSeries",
                "https://schema.org/TVEpisode",
                "https://schema.org/Book",
                "https://schema.org/VideoGame"
              ],
              "guards": {
                "requiredFailClosed": true
              }
            },
            {
              "name": "cover",
              "predicate": "https://schema.org/image",
              "kind": "iri",
              "maxCount": 1,
              "guards": {
                "iriScheme": "http-https",
                "iriPattern": "http-https"
              }
            }
          ]
        }
      ]
    }
  ]
}
