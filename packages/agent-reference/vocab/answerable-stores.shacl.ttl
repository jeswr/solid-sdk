    sh:property [ sh:path awp:publicKey; sh:name "publicKey"; sh:maxCount 1; sh:minCount 1; sh:node awp:StoreJsonWebKeyShape ] .

awp:StoreJsonWebKeyShape a sh:NodeShape;
