    sh:property [ sh:path awp:owner; sh:name "owner"; sh:maxCount 1; sh:minCount 1; sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] [ sh:datatype rdf:JSON ] ) ];
    sh:property [ sh:path awp:pinnedKey; sh:name "pinnedKey"; sh:node awp:PinnedKeyShape ];
