    sh:property [ sh:path awp:endpoint; sh:name "endpoint"; sh:maxCount 1; sh:or ( [ sh:node awp:StoreOrderedValuesShape ] [ sh:datatype rdf:JSON ] ) ];
    sh:property [ sh:path awp:note; sh:name "note"; sh:maxCount 1; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:JSON ] ) ];
