    sh:property [ sh:path awp:recordChecks; sh:name "recordChecks"; sh:maxCount 1; sh:minCount 1; sh:node awp:StoreOrderedValuesShape ];
    sh:property [ sh:path awp:at; sh:name "at"; sh:maxCount 1; sh:minCount 1; sh:datatype xsd:dateTime ];
    sh:property [ sh:path awp:recordFieldOrder; sh:name "recordFieldOrder"; sh:maxCount 1; sh:node awp:StoreOrderedValuesShape ].

