    sh:property [ sh:path awp:stateVersion; sh:name "stateVersion"; sh:maxCount 1; sh:minCount 1; sh:datatype xsd:integer ];
    sh:property [ sh:path awp:section; sh:name "section"; sh:minCount 1; sh:nodeKind sh:IRI ] .

