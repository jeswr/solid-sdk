awp:UntypedRecordShape a sh:NodeShape;
    sh:targetClass awp:UntypedRecord;
    sh:name "UntypedRecord";
    sh:property [ sh:path awp:recordValues; sh:name "recordValues"; sh:maxCount 1; sh:minCount 1; sh:node awp:StoreNamedValuesShape ].

awp:StoreNamedValuesShape a sh:NodeShape;
    sh:class awp:NamedValueCollection;
    sh:property [ sh:path schema:itemListElement; sh:node awp:StoreValueEntryShape ].

awp:StoreOrderedValuesShape a sh:NodeShape;
    sh:class schema:ItemList;
    sh:property [ sh:path schema:itemListElement; sh:node awp:StoreValueEntryShape ].

awp:StoreValueEntryShape a sh:NodeShape;
    sh:class schema:PropertyValue;
    sh:property [ sh:path schema:position; sh:datatype xsd:integer; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path schema:name; sh:datatype xsd:string; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path schema:propertyID; sh:nodeKind sh:IRI; sh:minCount 1; sh:maxCount 1 ];
    sh:property [ sh:path schema:value; sh:minCount 1; sh:maxCount 1;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:nodeKind sh:Literal ] ) ].

awp:RuntimeSnapshotShape a sh:NodeShape;
