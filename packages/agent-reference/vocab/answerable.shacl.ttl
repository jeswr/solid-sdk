awp:ProfileShape a sh:NodeShape;
    sh:targetClass <http://www.w3.org/ns/dx/prof/Profile>;
    sh:name "Profile";
    rdfs:comment "The pilot profile description uses prof:Profile / hasResource / hasRole.".
awp:EventShape a sh:NodeShape;
    sh:targetClass <https://schema.org/Event>;
    sh:name "Event";
    rdfs:comment "The agreed meeting slot is a schema:Event (startDate/endDate).".
awp:ImplementationDescriptionShape a sh:NodeShape;
    sh:targetClass awp:ImplementationDescription;
    sh:name "ImplementationDescription";
    rdfs:comment "What one agent implements vs accepts: configurations, operations, vocabularies. No reused term separates 'implemented' from 'accepted for interaction' (A3).".
awp:ConfigurationShape a sh:NodeShape;
    sh:targetClass awp:Configuration;
    sh:name "Configuration";
    rdfs:comment "One coherent mechanism combination (integrity + authentication + representation + authorisation + binding). Selection is per conversation; lists never imply products.".
awp:OwnerMandateShape a sh:NodeShape;
    sh:targetClass awp:OwnerMandate;
    sh:name "OwnerMandate";
    rdfs:comment "Owner-signed bound on what a software actor may do (autonomous vs with-approval ODRL policies + validity). Not a representation assertion.".
awp:RepresentationStatementShape a sh:NodeShape;
    sh:targetClass awp:RepresentationStatement;
    sh:name "RepresentationStatement";
    rdfs:comment "Party-signed statement that an actor key speaks for the party for listed operations. Establishes representation only; it authorises nothing at the receiver.".
awp:AgreementRecordShape a sh:NodeShape;
    sh:targetClass awp:AgreementRecord;
    sh:name "AgreementRecord";
    rdfs:comment "Documentary record relating offer, acceptance and exact terms digest (A8).".
awp:OutcomeConclusionShape a sh:NodeShape;
    sh:targetClass awp:OutcomeConclusion;
    sh:name "OutcomeConclusion";
    rdfs:comment "completed | not-executed | uncertain — an evaluator's conclusion about an activity.".
awp:EvidenceRoleShape a sh:NodeShape;
    sh:targetClass awp:EvidenceRole;
    sh:name "EvidenceRole";
    rdfs:comment "The role in which a credential or presentation is offered as evidence.".
awp:JwsProofShape a sh:NodeShape;
    sh:targetClass awp:JwsProof;
    sh:name "JwsProof";
    rdfs:comment "An enveloping Ed25519 JWS over the JCS canonical JSON-LD document with its proof removed.".
awp:DataIntegrityProofShape a sh:NodeShape;
    sh:targetClass <https://w3id.org/security#DataIntegrityProof>;
    sh:name "DataIntegrityProof";
    rdfs:comment "An embedded W3C Data Integrity proof over the canonical RDF document.".
