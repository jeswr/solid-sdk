    rdfs:label "Challenge";
    rdfs:comment "The challenge recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<http://purl.org/dc/terms/created> a rdf:Property;
    rdfs:label "Created";
    rdfs:comment "The created recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
