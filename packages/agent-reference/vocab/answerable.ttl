awp:GateOutcome a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Gate outcome";
    rdfs:comment "What the agent does after a run of checks, distinct from any one verdict.".
<https://w3id.org/jeswr/awp#gate-outcome/admit> a awp:GateOutcome;
    rdfs:label "Admit";
    rdfs:comment "The inbound gate admits the labelled message after every required check passes.".
<https://w3id.org/jeswr/awp#gate-outcome/ask-more> a awp:GateOutcome;
    rdfs:label "Ask more";
    rdfs:comment "The gate requests curative evidence or clarification and does not admit or release the requested action.".
<https://w3id.org/jeswr/awp#gate-outcome/refuse> a awp:GateOutcome;
    rdfs:label "Refuse";
    rdfs:comment "The inbound gate declines the message; refused statements do not become factual support.".
<https://w3id.org/jeswr/awp#gate-outcome/go> a awp:GateOutcome;
    rdfs:label "Go";
    rdfs:comment "The outbound gate releases the exact checked action after its decision is durably recorded.".
<https://w3id.org/jeswr/awp#gate-outcome/ask-principal> a awp:GateOutcome;
    rdfs:label "Ask principal";
    rdfs:comment "The gate holds the exact action or message for the required principal’s decision.".
<https://w3id.org/jeswr/awp#gate-outcome/stop> a awp:GateOutcome;
    rdfs:label "Stop";
    rdfs:comment "The outbound gate does not release the proposed action.".
awp:GrantKind a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Kind of grant";
    rdfs:comment "The kind of authorization artifact recorded; it does not itself establish a permission.".
<https://w3id.org/jeswr/awp#grant-kind/owner-mandate> a awp:GrantKind;
    rdfs:label "Owner mandate";
    rdfs:comment "A recorded owner mandate authorization artifact; the current verified grant and policy determine what it permits.".
<https://w3id.org/jeswr/awp#grant-kind/data-use> a awp:GrantKind;
    rdfs:label "Data use";
    rdfs:comment "A recorded data use authorization artifact; the current verified grant and policy determine what it permits.".
<https://w3id.org/jeswr/awp#grant-kind/access> a awp:GrantKind;
    rdfs:label "Access";
    rdfs:comment "A recorded access authorization artifact; the current verified grant and policy determine what it permits.".
<https://w3id.org/jeswr/awp#grant-kind/onward-use> a awp:GrantKind;
    rdfs:label "Onward use";
    rdfs:comment "A recorded onward use authorization artifact; the current verified grant and policy determine what it permits.".
<https://w3id.org/jeswr/awp#grant-kind/delegation> a awp:GrantKind;
    rdfs:label "Delegation";
    rdfs:comment "A recorded delegation authorization artifact; the current verified grant and policy determine what it permits.".

