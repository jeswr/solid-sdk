    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/security#proofValue> a rdf:Property;
    rdfs:label "Proof Value";
    rdfs:comment "The encoded cryptographic signature value.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/security#verificationMethod> a rdf:Property;
    rdfs:label "Verification Method";
    rdfs:comment "The independently resolved verification method used to check this proof.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/jeswr/awp#reason/malformed> a awp:ReasonCode;
    rdfs:label "Malformed";
    rdfs:comment "The document is not well formed under the selected message model.".
<https://w3id.org/jeswr/awp#reason/bounds-exceeded> a awp:ReasonCode;
    rdfs:label "Bounds exceeded";
    rdfs:comment "The input or task exceeds a configured resource bound.".
<https://w3id.org/jeswr/awp#reason/unsigned-not-allowed> a awp:ReasonCode;
    rdfs:label "Unsigned not allowed";
    rdfs:comment "The selected configuration requires a signature for this request.".
<https://w3id.org/jeswr/awp#reason/unknown-key> a awp:ReasonCode;
    rdfs:label "Unknown key";
    rdfs:comment "The verifier has no independently accepted verification material for this key.".
<https://w3id.org/jeswr/awp#reason/bad-signature> a awp:ReasonCode;
    rdfs:label "Bad signature";
    rdfs:comment "The cryptographic proof does not verify over this exact protected document.".
<https://w3id.org/jeswr/awp#reason/disallowed-header> a awp:ReasonCode;
    rdfs:label "Disallowed header";
    rdfs:comment "A JWS header contains a parameter this profile does not permit.".
<https://w3id.org/jeswr/awp#reason/configuration-mismatch> a awp:ReasonCode;
    rdfs:label "Configuration mismatch";
    rdfs:comment "The protection or mechanism used differs from the configuration named by the document.".
<https://w3id.org/jeswr/awp#reason/sender-key-mismatch> a awp:ReasonCode;
    rdfs:label "Sender key mismatch";
    rdfs:comment "The claimed sender is not the actor to which the independently resolved signing key belongs.".
<https://w3id.org/jeswr/awp#reason/wrong-audience> a awp:ReasonCode;
    rdfs:label "Wrong audience";
    rdfs:comment "The message is addressed to a different actor or party.".
<https://w3id.org/jeswr/awp#reason/expired> a awp:ReasonCode;
    rdfs:label "Expired";
    rdfs:comment "The current time is after the end of the document’s validity window.".
<https://w3id.org/jeswr/awp#reason/not-yet-valid> a awp:ReasonCode;
    rdfs:label "Not yet valid";
    rdfs:comment "The document’s validity window has not started.".
<https://w3id.org/jeswr/awp#reason/lifetime-too-long> a awp:ReasonCode;
    rdfs:label "Lifetime too long";
    rdfs:comment "The document’s validity window exceeds the configured maximum.".
<https://w3id.org/jeswr/awp#reason/replay-conflict> a awp:ReasonCode;
    rdfs:label "Replay conflict";
    rdfs:comment "A one-time identifier or nonce is reused, unissued or bound to different content.".
<https://w3id.org/jeswr/awp#reason/capacity> a awp:ReasonCode;
    rdfs:label "Capacity";
    rdfs:comment "Capacity: the reason code identified by the stable code “capacity”.".
<https://w3id.org/jeswr/awp#reason/no-structured-content> a awp:ReasonCode;
    rdfs:label "No structured content";
    rdfs:comment "No structured content: the reason code identified by the stable code “no-structured-content”.".
<https://w3id.org/jeswr/awp#reason/conflicting-structured-copies> a awp:ReasonCode;
    rdfs:label "Conflicting structured copies";
    rdfs:comment "Conflicting structured copies: the reason code identified by the stable code “conflicting-structured-copies”.".
<https://w3id.org/jeswr/awp#reason/human-parity-mismatch> a awp:ReasonCode;
    rdfs:label "Human parity mismatch";
    rdfs:comment "Human parity mismatch: the reason code identified by the stable code “human-parity-mismatch”.".
<https://w3id.org/jeswr/awp#reason/unsupported-profile> a awp:ReasonCode;
    rdfs:label "Unsupported profile";
    rdfs:comment "Unsupported profile: the reason code identified by the stable code “unsupported-profile”.".
<https://w3id.org/jeswr/awp#reason/unsupported-configuration> a awp:ReasonCode;
    rdfs:label "Unsupported configuration";
    rdfs:comment "The receiver does not implement or accept the requested complete configuration.".
<https://w3id.org/jeswr/awp#reason/unsupported-operation> a awp:ReasonCode;
    rdfs:label "Unsupported operation";
    rdfs:comment "The receiver does not offer the requested operation version.".
<https://w3id.org/jeswr/awp#reason/unsupported-kind> a awp:ReasonCode;
    rdfs:label "Unsupported kind";
    rdfs:comment "The receiver does not implement the requested message kind.".
<https://w3id.org/jeswr/awp#reason/unsupported-term> a awp:ReasonCode;
    rdfs:label "Unsupported term";
    rdfs:comment "A term material to this decision has no supported interpretation.".
<https://w3id.org/jeswr/awp#reason/protocol-violation> a awp:ReasonCode;
    rdfs:label "Protocol violation";
    rdfs:comment "The message is not a permitted transition of this conversation.".
<https://w3id.org/jeswr/awp#reason/terms-digest-mismatch> a awp:ReasonCode;
    rdfs:label "Terms digest mismatch";
    rdfs:comment "The accepted or referenced digest differs from the exact offered terms document.".
<https://w3id.org/jeswr/awp#reason/round-limit> a awp:ReasonCode;
    rdfs:label "Round limit";
    rdfs:comment "The conversation has exhausted its permitted negotiation or request rounds.".
<https://w3id.org/jeswr/awp#reason/conversation-closed> a awp:ReasonCode;
    rdfs:label "Conversation closed";
    rdfs:comment "The conversation has ended and cannot accept this transition.".
<https://w3id.org/jeswr/awp#reason/representation-missing> a awp:ReasonCode;
    rdfs:label "Representation missing";
    rdfs:comment "No required statement of representation was supplied.".
<https://w3id.org/jeswr/awp#reason/representation-invalid> a awp:ReasonCode;
    rdfs:label "Representation invalid";
    rdfs:comment "The supplied representation does not verify or has an invalid delegation structure.".
<https://w3id.org/jeswr/awp#reason/representation-expired> a awp:ReasonCode;
    rdfs:label "Representation expired";
    rdfs:comment "The statement of representation is outside its validity window.".
<https://w3id.org/jeswr/awp#reason/representation-out-of-scope> a awp:ReasonCode;
    rdfs:label "Representation out of scope";
    rdfs:comment "The verified representation does not cover this entity, subject, action, operation or purpose.".
<https://w3id.org/jeswr/awp#reason/source-not-authoritative> a awp:ReasonCode;
    rdfs:label "Source not authoritative";
    rdfs:comment "The source is not accepted for this claim kind, subject or purpose.".
<https://w3id.org/jeswr/awp#reason/evidence-invalid> a awp:ReasonCode;
    rdfs:label "Evidence invalid";
    rdfs:comment "The supplied support does not verify or differs from admitted evidence.".
<https://w3id.org/jeswr/awp#reason/not-authorised> a awp:ReasonCode;
    rdfs:label "Not authorised";
    rdfs:comment "No applicable grant permits the proposed action as actually parameterized.".
<https://w3id.org/jeswr/awp#reason/mandate-invalid> a awp:ReasonCode;
    rdfs:label "Mandate invalid";
    rdfs:comment "The principal’s operational mandate cannot be loaded and verified for this agent.".
<https://w3id.org/jeswr/awp#reason/assurance-insufficient> a awp:ReasonCode;
    rdfs:label "Assurance insufficient";
    rdfs:comment "The supplied assurance or approval strength is weaker than the receiver requires.".
<https://w3id.org/jeswr/awp#reason/approval-required> a awp:ReasonCode;
    rdfs:label "Approval required";
    rdfs:comment "A principal or named decision maker must approve this exact action before it may proceed.".
