    rdfs:range rdfs:Resource.
awp:asOf a rdf:Property;
    rdfs:label "As Of";
    rdfs:comment "The as of recorded for this resource.";
    rdfs:domain awp:StatementSubject;
    rdfs:range xsd:dateTime.
awp:proofBinds a rdf:Property;
    rdfs:label "Proof Binds";
    rdfs:comment "The aspects of a derivation independently established by the proof verifier.";
    rdfs:domain awp:Assurance;
    rdfs:range rdfs:Resource.
<https://schema.org/price> a rdf:Property;
    rdfs:label "Price";
    rdfs:comment "The price recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:decimal.
<https://schema.org/priceCurrency> a rdf:Property;
    rdfs:label "Price Currency";
    rdfs:comment "The price currency recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:string.
<https://schema.org/amount> a rdf:Property;
    rdfs:label "Amount";
    rdfs:comment "The amount recorded for this resource.";
    rdfs:domain <https://schema.org/PayAction>;
    rdfs:range xsd:decimal.
<http://www.w3.org/ns/odrl/2/permission> a rdf:Property;
    rdfs:label "Permission";
    rdfs:comment "The permission recorded for this resource.";
    rdfs:domain awp:Policy;
    rdfs:range rdfs:Resource.
<http://www.w3.org/ns/odrl/2/prohibition> a rdf:Property;
    rdfs:label "Prohibition";
    rdfs:comment "The prohibition recorded for this resource.";
    rdfs:domain awp:Policy;
    rdfs:range rdfs:Resource.
<http://www.w3.org/ns/odrl/2/duty> a rdf:Property;
    rdfs:label "Duty";
    rdfs:comment "The duty recorded for this resource.";
    rdfs:domain awp:Policy;
    rdfs:range rdfs:Resource.
awp:assurance a rdf:Property;
    rdfs:label "Assurance";
    rdfs:comment "How the receiver is assured of this derivation.";
    rdfs:domain rdfs:Resource;
    rdfs:range awp:Assurance.
awp:check a rdf:Property;
    rdfs:label "Check";
    rdfs:comment "The question answered by this gate check.";
    rdfs:domain rdfs:Resource;
    rdfs:range awp:CheckName.
awp:verdict a rdf:Property;
    rdfs:label "Verdict";
    rdfs:comment "The answer to the gate’s question.";
    rdfs:domain rdfs:Resource;
    rdfs:range awp:Verdict.
awp:basisKind a rdf:Property;
    rdfs:label "Basis Kind";
    rdfs:comment "Whether the request relies on an agreement, public request, representation, grant or invocation.";
    rdfs:domain rdfs:Resource;
    rdfs:range awp:BasisKind.
<https://www.w3.org/2018/credentials#verifiableCredential> a rdf:Property;
    rdfs:label "Credential";
    rdfs:comment "The embedded source credential or presentation offered as evidence.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:jws a rdf:Property;
    rdfs:label "Jws";
    rdfs:comment "The compact JWS over the exact canonical JSON-LD document.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:string.
