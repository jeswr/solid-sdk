    rdfs:label "Assertion Method";
    rdfs:comment "The assertion method recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/security#authenticationMethod> a rdf:Property;
    rdfs:label "Authentication";
    rdfs:comment "The authentication recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/security#capabilityInvocationMethod> a rdf:Property;
    rdfs:label "Capability Invocation";
    rdfs:comment "The capability invocation recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/security#capabilityDelegationMethod> a rdf:Property;
    rdfs:label "Capability Delegation";
    rdfs:comment "The capability delegation recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/security#keyAgreementMethod> a rdf:Property;
