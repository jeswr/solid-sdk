    rdfs:range rdfs:Resource.
awp:invocation a rdf:Property;
    rdfs:label "Invocation";
    rdfs:comment "The invocation recorded for this resource.";
    rdfs:domain awp:RequestBasis;
    rdfs:range rdfs:Resource.
<https://www.w3.org/2018/credentials#issuer> a rdf:Property;
    rdfs:label "Issuer";
    rdfs:comment "The issuer recorded for this resource.";
    rdfs:domain <https://www.w3.org/2018/credentials#VerifiableCredential>;
    rdfs:range rdfs:Resource.
<https://www.w3.org/2018/credentials#credentialSubject> a rdf:Property;
    rdfs:label "Credential Subject";
    rdfs:comment "The credential subject recorded for this resource.";
    rdfs:domain <https://www.w3.org/2018/credentials#VerifiableCredential>;
    rdfs:range rdfs:Resource.
<https://www.w3.org/2018/credentials#validFrom> a rdf:Property;
    rdfs:label "Valid From";
    rdfs:comment "The valid from recorded for this resource.";
    rdfs:domain <https://www.w3.org/2018/credentials#VerifiableCredential>;
