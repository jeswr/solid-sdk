# AUTHORED-BY Codex GPT-6
@prefix awp: <https://w3id.org/jeswr/awp#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://w3id.org/jeswr/awp> a <http://www.w3.org/2002/07/owl#Ontology>;
    rdfs:label "Answerable agent interaction model";
    rdfs:comment "The message model, gate questions, outcomes and proof bindings of the Answerable protocol. Version 1 is immutable; semantic changes require a new context version.";
    <http://www.w3.org/2002/07/owl#versionInfo> "1".
rdfs:label a rdf:Property;
    rdfs:label "Label";
    rdfs:comment "The human-readable name of this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:string.
awp:ParticipantRef a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Participant Ref";
    rdfs:comment "Who produced a statement (A1). `actor` is the software agent that produced (and, under\nthe signed configurations, signed) the message; `onBehalfOf` is the represented party;\n`operator` is who runs the software. All three are CLAIMS until assessed. `actor` is\nabsent only under a configuration that permits anonymous requests.".
awp:AudienceRef a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Audience Ref";
    rdfs:comment "The intended audience of a message. Absent only for public responses.".
awp:OperationRef a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Operation Ref";
    rdfs:comment "A versioned reference to an operation definition.";
    <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://schema.org/Action>.
awp:EvidenceItem a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Evidence Item";
    rdfs:comment "A protected statement carried alongside a message (A1 relay, A6 evidence).".
awp:DescribeBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Describe Body";
    rdfs:comment "The describe body defined by the interaction model.".
awp:DescriptionBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Description Body";
    rdfs:comment "The description body defined by the interaction model.".
awp:ProposeBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Propose Body";
    rdfs:comment "The propose body defined by the interaction model.".
awp:AcceptBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Accept Body";
    rdfs:comment "The accept body defined by the interaction model.".
awp:ChallengeBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Challenge Body";
    rdfs:comment "What more the sender must supply before its request can be admitted (CORE-M-8).".
awp:RefuseBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Refuse Body";
    rdfs:comment "The refuse body defined by the interaction model.".
awp:InvokeBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Invoke Body";
    rdfs:comment "The invoke body defined by the interaction model.".
awp:InvokeBodyChallenge a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Invoke Body Challenge";
    rdfs:comment "The challenge component of InvokeBody.".
awp:DeliverBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Deliver Body";
    rdfs:comment "The deliver body defined by the interaction model.".
awp:ReceiptBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Receipt Body";
    rdfs:comment "A report of an executed activity and the reporter's conclusion about it (A11).".
awp:UnsupportedBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Unsupported Body";
    rdfs:comment "The unsupported body defined by the interaction model.".
awp:IndeterminateBody a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Indeterminate Body";
    rdfs:comment "The indeterminate body defined by the interaction model.".
awp:ContentPart a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Content Part";
    rdfs:comment "One logical interaction message. Every field here is consequential and therefore\nprotected by the selected integrity mechanism: profile, configuration, identity, kind,\naudience, conversation, times, reply linkage, body and evidence.".
awp:Message a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Message";
    rdfs:comment "The message defined by the interaction model.".
awp:MessageAuthorship a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Message Authorship";
    rdfs:comment "The authorship component of Message.".
awp:VerificationResult a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Verification Result";
    rdfs:comment "The verification result defined by the interaction model.".
awp:RepresentationAssessment a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Representation Assessment";
    rdfs:comment "Does the evaluator accept that `actor` speaks for `party` for this operation (A1/A3)?".
awp:SourceAuthorityAssessment a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Source Authority Assessment";
    rdfs:comment "Does the evaluator accept `source` for this claim type about this subject (A7)?".
awp:SourceAuthorityAssessmentRule a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Source Authority Assessment Rule";
    rdfs:comment "The rule component of SourceAuthorityAssessment.".
awp:ActionIntent a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Action Intent";
    rdfs:comment "An action the local executor is about to perform, as evaluated against a mandate.".
awp:AuthorisationDecision a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Authorisation Decision";
    rdfs:comment "The authorisation decision defined by the interaction model.".
awp:AuthorisationDecisionPolicy a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Authorisation Decision Policy";
    rdfs:comment "The policy component of AuthorisationDecision.".
<http://www.w3.org/ns/odrl/2/Agreement> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Agreement";
    rdfs:comment "An agreement formed by an accept referring to an identified offer (A8).".
awp:GrantRecord a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Grant Record";
    rdfs:comment "A grant: an authorisation artefact (mandate, data-use grant, access grant) (A4).".
<http://www.w3.org/ns/prov#Activity> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Activity";
    rdfs:comment "The activity record defined by the interaction model.".
awp:OutcomeRecord a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Outcome Record";
    rdfs:comment "The outcome record defined by the interaction model.".
awp:RequestBasis a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Request Basis";
    rdfs:comment "The basis claimed for a request; it grants no authority by itself.".
<https://www.w3.org/2018/credentials#VerifiableCredential> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Verifiable Credential";
    rdfs:comment "A principal-issued Verifiable Credential binding the agent to ODRL policies and a validity window.".
awp:StatementSubject a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Statement Subject";
    rdfs:comment "The subject and claims to which the source credential applies.".
awp:Assurance a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Assurance";
    rdfs:comment "The receiver’s means of being assured of a derivation; it establishes only its stated bindings.".
awp:ReasonCode a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Reason Code";
    rdfs:comment "A named explanation of a verdict. A reason never grants authority.".
awp:MessageKind a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Message Kind";
    rdfs:comment "A named protocol-message kind.".
awp:CheckName a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Check Name";
    rdfs:comment "A named question answered by a gate.".
awp:Verdict a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Verdict";
    rdfs:comment "The answer to one gate check.".
awp:CheckResultCode a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Check Result Code";
    rdfs:comment "A passing or not-applicable explanation of a check.".
awp:ProofBinding a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Proof Binding";
    rdfs:comment "One aspect independently established by a derivation proof.".
<http://www.w3.org/ns/prov#Agent> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Agent";
    rdfs:comment "A person, organization or software actor; roles and authority are assessed separately.".
<https://schema.org/Offer> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Offer";
    rdfs:comment "An offer whose price and currency are explicit.".
<https://schema.org/PayAction> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Pay Action";
    rdfs:comment "An attempted payment, distinct from settlement.".
<https://schema.org/Invoice> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Invoice";
    rdfs:comment "A document requesting payment.".
<http://www.w3.org/ns/odrl/2/Policy> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Policy";
    rdfs:comment "An ODRL policy defining permissions, prohibitions and duties.".
awp:Describe a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Describe";
    rdfs:comment "The describe message: asks a party to describe its configurations and operations.";
    rdfs:subClassOf awp:Message.
awp:Description a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Description";
    rdfs:comment "The description message: answers a description request.";
    rdfs:subClassOf awp:Message.
awp:Propose a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Propose";
    rdfs:comment "The propose message: offers exact terms for an operation.";
    rdfs:subClassOf awp:Message.
awp:Accept a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Accept";
    rdfs:comment "The accept message: accepts exact terms by digest.";
    rdfs:subClassOf awp:Message.
awp:Refuse a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Refuse";
    rdfs:comment "The refuse message: declines with a reason.";
    rdfs:subClassOf awp:Message.
awp:Challenge a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Challenge";
    rdfs:comment "The challenge message: states what additional evidence would satisfy the gate.";
    rdfs:subClassOf awp:Message.
awp:Invoke a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Invoke";
    rdfs:comment "The invoke message: requests an operation on an explicit basis.";
    rdfs:subClassOf awp:Message.
awp:Deliver a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Deliver";
    rdfs:comment "The deliver message: delivers data or a result.";
    rdfs:subClassOf awp:Message.
awp:Receipt a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Receipt";
    rdfs:comment "The receipt message: reports what was received or done.";
    rdfs:subClassOf awp:Message.
awp:Unsupported a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Unsupported";
    rdfs:comment "The unsupported message: identifies an unsupported request.";
    rdfs:subClassOf awp:Message.
awp:Indeterminate a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Indeterminate";
    rdfs:comment "The indeterminate message: reports that the receiver cannot decide.";
    rdfs:subClassOf awp:Message.
<http://www.w3.org/ns/dx/prof/Profile> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Profile";
    rdfs:comment "The pilot profile description uses prof:Profile / hasResource / hasRole.".
<https://schema.org/Event> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Event";
    rdfs:comment "The agreed meeting slot is a schema:Event (startDate/endDate).".
awp:ImplementationDescription a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Implementation Description";
    rdfs:comment "What one agent implements vs accepts: configurations, operations, vocabularies. No reused term separates 'implemented' from 'accepted for interaction' (A3).";
    <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://www.w3.org/ns/dcat#DataService>.
awp:Configuration a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Configuration";
    rdfs:comment "One coherent mechanism combination (integrity + authentication + representation + authorisation + binding). Selection is per conversation; lists never imply products.".
awp:OwnerMandate a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Owner Mandate";
    rdfs:comment "Owner-signed bound on what a software actor may do (autonomous vs with-approval ODRL policies + validity). Not a representation assertion.";
    rdfs:subClassOf <https://www.w3.org/2018/credentials#VerifiableCredential>;
    <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://www.w3.org/ns/odrl/2/Policy>.
awp:RepresentationStatement a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Representation Statement";
    rdfs:comment "Party-signed statement that an actor key speaks for the party for listed operations. Establishes representation only; it authorises nothing at the receiver.".
awp:AgreementRecord a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Agreement Record";
    rdfs:comment "Documentary record relating offer, acceptance and exact terms digest (A8).";
    <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://www.w3.org/ns/odrl/2/Agreement>.
awp:OutcomeConclusion a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Outcome Conclusion";
    rdfs:comment "completed | not-executed | uncertain — an evaluator's conclusion about an activity.".
awp:EvidenceRole a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Evidence Role";
    rdfs:comment "The role in which a credential or presentation is offered as evidence.".
awp:JwsProof a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Jws Proof";
    rdfs:comment "An enveloping Ed25519 JWS over the JCS canonical JSON-LD document with its proof removed.".
<https://w3id.org/security#DataIntegrityProof> a <http://www.w3.org/2002/07/owl#Class>;
    rdfs:label "Data Integrity Proof";
    rdfs:comment "An embedded W3C Data Integrity proof over the canonical RDF document.".
awp:actor a rdf:Property;
    rdfs:label "Actor";
    rdfs:comment "The software actor responsible for producing a message or attempting an effect.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<http://www.w3.org/ns/prov#actedOnBehalfOf> a rdf:Property;
    rdfs:label "On Behalf Of";
    rdfs:comment "The on behalf of recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<http://www.w3.org/ns/odrl/2/operator> a rdf:Property;
    rdfs:label "Operator";
    rdfs:comment "The comparison operator used by an ODRL constraint.";
    rdfs:domain <http://www.w3.org/ns/odrl/2/Constraint>;
    rdfs:range rdfs:Resource.
awp:operator a rdf:Property;
    rdfs:label "Software operator";
    rdfs:comment "The party running the software; this implies no representation or authorization.";
    rdfs:domain awp:ParticipantRef;
    rdfs:range rdfs:Resource.
awp:party a rdf:Property;
    rdfs:label "Party";
    rdfs:comment "The person or organization concerned.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:version a rdf:Property;
    rdfs:label "Version";
    rdfs:comment "The version recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:string.
awp:role a rdf:Property;
    rdfs:label "Role";
    rdfs:comment "The role in which an evidence document is offered.";
    rdfs:domain awp:EvidenceItem;
    rdfs:range awp:EvidenceRole.
awp:format a rdf:Property;
    rdfs:label "Format";
    rdfs:comment "The protection format used by the evidence document.";
    rdfs:domain awp:EvidenceItem;
    rdfs:range xsd:string.
awp:value a rdf:Property;
    rdfs:label "Value";
    rdfs:comment "The statement or value this evidence item carries; not a declaration of truth.";
    rdfs:domain rdfs:Resource;
    rdfs:range <https://www.w3.org/2018/credentials#VerifiableCredential>.
awp:want a rdf:Property;
    rdfs:label "Want";
    rdfs:comment "The want recorded for this resource.";
    rdfs:domain awp:DescribeBody;
    rdfs:range rdfs:Resource.
awp:description a rdf:Property;
    rdfs:label "Description";
    rdfs:comment "The description recorded for this resource.";
    rdfs:domain awp:DescriptionBody;
    rdfs:range rdfs:Resource.
awp:operation a rdf:Property;
    rdfs:label "Operation";
    rdfs:comment "A versioned reference to the operation being proposed or invoked.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:terms a rdf:Property;
    rdfs:label "Terms";
    rdfs:comment "The terms of this offer or the policy restricting use of this data.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:termsDigest a rdf:Property;
    rdfs:label "Terms Digest";
    rdfs:comment "The digest of the exact document containing the terms being offered or accepted.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:string.
awp:round a rdf:Property;
    rdfs:label "Round";
    rdfs:comment "The one-based proposal round; loops are bounded by the configuration.";
    rdfs:domain awp:ProposeBody;
    rdfs:range xsd:integer.
awp:counters a rdf:Property;
    rdfs:label "Counters";
    rdfs:comment "The proposal this one counters, if any.";
    rdfs:domain awp:ProposeBody;
    rdfs:range rdfs:Resource.
awp:proposal a rdf:Property;
    rdfs:label "Proposal";
    rdfs:comment "The proposal recorded for this resource.";
    rdfs:domain awp:AcceptBody;
    rdfs:range rdfs:Resource.
awp:selection a rdf:Property;
    rdfs:label "Selection";
    rdfs:comment "The option chosen where the offer permitted a choice.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:agreement a rdf:Property;
    rdfs:label "Agreement";
    rdfs:comment "Deterministic agreement id (both sides compute and compare it).";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:ref a rdf:Property;
    rdfs:label "Ref";
    rdfs:comment "The message or action to which this response refers.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:reason a rdf:Property;
    rdfs:label "Reason";
    rdfs:comment "The reason for a verdict or refusal; a reason never grants authority.";
    rdfs:domain rdfs:Resource;
    rdfs:range awp:ReasonCode.
awp:detail a rdf:Property;
    rdfs:label "Detail";
    rdfs:comment "Additional diagnostic content; it does not grant authority.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:string.
awp:needs a rdf:Property;
    rdfs:label "Needs";
    rdfs:comment "The gate-built requirement that a sender must satisfy before admission.";
    rdfs:domain awp:ChallengeBody;
    rdfs:range rdfs:Resource.
awp:nonce a rdf:Property;
    rdfs:label "Nonce";
    rdfs:comment "The one-time challenge value binding the retry to this request.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:challenge a rdf:Property;
    rdfs:label "Challenge";
    rdfs:comment "The challenge recorded for this resource.";
    rdfs:domain awp:InvokeBody;
    rdfs:range awp:InvokeBodyChallenge.
awp:input a rdf:Property;
    rdfs:label "Input";
    rdfs:comment "The input recorded for this resource.";
    rdfs:domain awp:InvokeBody;
    rdfs:range rdfs:Resource.
awp:basis a rdf:Property;
    rdfs:label "Basis";
    rdfs:comment "The agreement, public request, representation, grant or invocation on which this request relies.";
    rdfs:domain rdfs:Resource;
    rdfs:range awp:RequestBasis.
<https://w3id.org/dpv#hasPurpose> a rdf:Property;
    rdfs:label "Purpose";
    rdfs:comment "The purpose recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:output a rdf:Property;
    rdfs:label "Output";
    rdfs:comment "The output recorded for this resource.";
    rdfs:domain awp:DeliverBody;
    rdfs:range rdfs:Resource.
awp:activity a rdf:Property;
    rdfs:label "Activity";
    rdfs:comment "The attempted effect whose outcome is reported.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:outcome a rdf:Property;
    rdfs:label "Outcome";
    rdfs:comment "The evaluator’s conclusion about an attempted effect, distinct from the effect itself.";
    rdfs:domain rdfs:Resource;
    rdfs:range awp:OutcomeConclusion.
awp:observed a rdf:Property;
    rdfs:label "Observed";
    rdfs:comment "The observed recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:final a rdf:Property;
    rdfs:label "Final";
    rdfs:comment "True if this is the reporter's final receipt for `ref`.";
    rdfs:domain awp:ReceiptBody;
    rdfs:range xsd:boolean.
awp:mediaType a rdf:Property;
    rdfs:label "Media Type";
    rdfs:comment "The media type recorded for this resource.";
    rdfs:domain awp:ContentPart;
    rdfs:range xsd:string.
awp:digest a rdf:Property;
    rdfs:label "Digest";
    rdfs:comment "The digest recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:string.
awp:bytes a rdf:Property;
    rdfs:label "Bytes";
    rdfs:comment "UTF-8 text or raw byte values in this JSON binding.";
    rdfs:domain awp:ContentPart;
    rdfs:range rdfs:Resource.
awp:profile a rdf:Property;
    rdfs:label "Profile";
    rdfs:comment "The versioned semantic profile under which this resource is interpreted.";
    rdfs:domain awp:Message;
    rdfs:range rdfs:Resource.
awp:configuration a rdf:Property;
    rdfs:label "Configuration";
    rdfs:comment "The complete configuration of suites selected for the conversation.";
    rdfs:domain awp:Message;
    rdfs:range rdfs:Resource.
awp:conversation a rdf:Property;
    rdfs:label "Conversation";
    rdfs:comment "The interaction to which this message or action belongs.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:kind a rdf:Property;
    rdfs:label "Kind";
    rdfs:comment "The protocol kind of the message; not an authorization.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:from a rdf:Property;
    rdfs:label "From";
    rdfs:comment "The claimed sender, including software actor, represented principal and operator.";
    rdfs:domain awp:Message;
    rdfs:range awp:ParticipantRef.
awp:to a rdf:Property;
    rdfs:label "To";
    rdfs:comment "The intended audience of the message; absent only for a public response.";
    rdfs:domain awp:Message;
    rdfs:range awp:AudienceRef.
awp:createdAt a rdf:Property;
    rdfs:label "Created At";
    rdfs:comment "The time at which the message was created.";
    rdfs:domain awp:Message;
    rdfs:range xsd:dateTime.
awp:expiresAt a rdf:Property;
    rdfs:label "Expires At";
    rdfs:comment "The time after which the message must not be accepted.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:dateTime.
awp:inReplyTo a rdf:Property;
    rdfs:label "In Reply To";
    rdfs:comment "The earlier message to which this message replies.";
    rdfs:domain awp:Message;
    rdfs:range rdfs:Resource.
awp:method a rdf:Property;
    rdfs:label "Method";
    rdfs:comment "How the source states that it produced the claim.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:string.
awp:authorship a rdf:Property;
    rdfs:label "Authorship";
    rdfs:comment "The authorship recorded for this resource.";
    rdfs:domain awp:Message;
    rdfs:range awp:MessageAuthorship.
awp:body a rdf:Property;
    rdfs:label "Body";
    rdfs:comment "The content whose interpretation is fixed by the message kind.";
    rdfs:domain awp:Message;
    rdfs:range rdfs:Resource.
awp:evidence a rdf:Property;
    rdfs:label "Evidence";
    rdfs:comment "The evidence offered for a claim; its authority is assessed independently.";
    rdfs:domain awp:Message;
    rdfs:range awp:EvidenceItem.
awp:content a rdf:Property;
    rdfs:label "Content";
    rdfs:comment "A bounded original content part protected by this message.";
    rdfs:domain awp:Message;
    rdfs:range awp:ContentPart.
awp:protectedObject a rdf:Property;
    rdfs:label "Protected Object";
    rdfs:comment "Digest of the exact protected bytes examined.";
    rdfs:domain awp:VerificationResult;
    rdfs:range xsd:string.
awp:property a rdf:Property;
    rdfs:label "Property";
    rdfs:comment "What was tested — never \"truth\" or \"authority\".";
    rdfs:domain awp:VerificationResult;
    rdfs:range xsd:string.
awp:mechanism a rdf:Property;
    rdfs:label "Mechanism";
    rdfs:comment "The mechanism recorded for this resource.";
    rdfs:domain awp:VerificationResult;
    rdfs:range xsd:string.
awp:verificationMaterial a rdf:Property;
    rdfs:label "Verification Material";
    rdfs:comment "Pinned verification material used (key thumbprint), if any.";
    rdfs:domain awp:VerificationResult;
    rdfs:range xsd:string.
<http://www.w3.org/ns/prov#wasAttributedTo> a rdf:Property;
    rdfs:label "Attributed To";
    rdfs:comment "The identifier the pinned material is bound to in the local trust store.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:verifier a rdf:Property;
    rdfs:label "Verifier";
    rdfs:comment "The verifier recorded for this resource.";
    rdfs:domain awp:VerificationResult;
    rdfs:range rdfs:Resource.
awp:at a rdf:Property;
    rdfs:label "At";
    rdfs:comment "The at recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:dateTime.
awp:limitations a rdf:Property;
    rdfs:label "Limitations";
    rdfs:comment "The limitations recorded for this resource.";
    rdfs:domain awp:VerificationResult;
    rdfs:range xsd:string.
awp:deciderRole a rdf:Property;
    rdfs:label "Decider Role";
    rdfs:comment "The decider role recorded for this resource.";
    rdfs:domain awp:RepresentationAssessment;
    rdfs:range xsd:string.
awp:evaluator a rdf:Property;
    rdfs:label "Evaluator";
    rdfs:comment "The evaluator recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:statement a rdf:Property;
    rdfs:label "Statement";
    rdfs:comment "The statement recorded for this resource.";
    rdfs:domain awp:RepresentationAssessment;
    rdfs:range rdfs:Resource.
awp:claimType a rdf:Property;
    rdfs:label "Claim Type";
    rdfs:comment "The profile-defined kind of claim for which source authority and fitness are checked.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:string.
awp:subject a rdf:Property;
    rdfs:label "Subject";
    rdfs:comment "The subject about which a claim is made; a mandate binds its agent here.";
    rdfs:domain awp:SourceAuthorityAssessment;
    rdfs:range rdfs:Resource.
awp:rule a rdf:Property;
    rdfs:label "Rule";
    rdfs:comment "The rule recorded for this resource.";
    rdfs:domain awp:SourceAuthorityAssessment;
    rdfs:range awp:SourceAuthorityAssessmentRule.
<http://www.w3.org/ns/odrl/2/action> a rdf:Property;
    rdfs:label "Action";
    rdfs:comment "The ODRL-level action class (e.g. `use`, `distribute`, `compensate`, `read`).";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:string.
<http://www.w3.org/ns/odrl/2/target> a rdf:Property;
    rdfs:label "Target";
    rdfs:comment "Target asset/operation/resource.";
    rdfs:domain awp:ActionIntent;
    rdfs:range rdfs:Resource.
awp:recipient a rdf:Property;
    rdfs:label "Recipient";
    rdfs:comment "The party that receives the effect or data.";
    rdfs:domain awp:ActionIntent;
    rdfs:range rdfs:Resource.
awp:parameters a rdf:Property;
    rdfs:label "Parameters";
    rdfs:comment "The consequential parameters of the proposed action, as evaluated by the gate.";
    rdfs:domain awp:ActionIntent;
    rdfs:range rdfs:Resource.
awp:decider a rdf:Property;
    rdfs:label "Decider";
    rdfs:comment "The decider recorded for this resource.";
    rdfs:domain awp:AuthorisationDecision;
    rdfs:range rdfs:Resource.
awp:actionDigest a rdf:Property;
    rdfs:label "Action Digest";
    rdfs:comment "The digest of the exact proposed message or action approved by the principal.";
    rdfs:domain awp:AuthorisationDecision;
    rdfs:range xsd:string.
awp:policy a rdf:Property;
    rdfs:label "Policy";
    rdfs:comment "The grant/policy evaluated (id + digest), e.g. the owner mandate.";
    rdfs:domain awp:AuthorisationDecision;
    rdfs:range awp:AuthorisationDecisionPolicy.
awp:approval a rdf:Property;
    rdfs:label "Approval";
    rdfs:comment "The approval level requested by an authority challenge.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
awp:matchedRule a rdf:Property;
    rdfs:label "Matched Rule";
    rdfs:comment "The matched rule recorded for this resource.";
    rdfs:domain awp:AuthorisationDecision;
    rdfs:range xsd:string.
awp:offer a rdf:Property;
    rdfs:label "Offer";
    rdfs:comment "The offer recorded for this resource.";
    rdfs:domain <http://www.w3.org/ns/odrl/2/Agreement>;
    rdfs:range rdfs:Resource.
awp:acceptance a rdf:Property;
    rdfs:label "Acceptance";
    rdfs:comment "The acceptance recorded for this resource.";
    rdfs:domain <http://www.w3.org/ns/odrl/2/Agreement>;
    rdfs:range rdfs:Resource.
awp:offeror a rdf:Property;
    rdfs:label "Offeror";
    rdfs:comment "The offeror recorded for this resource.";
    rdfs:domain <http://www.w3.org/ns/odrl/2/Agreement>;
    rdfs:range awp:ParticipantRef.
awp:acceptor a rdf:Property;
    rdfs:label "Acceptor";
    rdfs:comment "The acceptor recorded for this resource.";
    rdfs:domain <http://www.w3.org/ns/odrl/2/Agreement>;
    rdfs:range awp:ParticipantRef.
awp:formedAt a rdf:Property;
    rdfs:label "Formed At";
    rdfs:comment "The formed at recorded for this resource.";
    rdfs:domain <http://www.w3.org/ns/odrl/2/Agreement>;
    rdfs:range xsd:dateTime.
awp:grantor a rdf:Property;
    rdfs:label "Grantor";
    rdfs:comment "The grantor recorded for this resource.";
    rdfs:domain awp:GrantRecord;
    rdfs:range rdfs:Resource.
awp:grantee a rdf:Property;
    rdfs:label "Grantee";
    rdfs:comment "The grantee recorded for this resource.";
    rdfs:domain awp:GrantRecord;
    rdfs:range rdfs:Resource.
<https://www.w3.org/2018/credentials#validUntil> a rdf:Property;
    rdfs:label "Valid Until";
    rdfs:comment "The valid until recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range xsd:dateTime.
<http://www.w3.org/ns/prov#wasDerivedFrom> a rdf:Property;
    rdfs:label "Derived From";
    rdfs:comment "The derived from recorded for this resource.";
    rdfs:domain awp:GrantRecord;
    rdfs:range rdfs:Resource.
awp:activityType a rdf:Property;
    rdfs:label "Activity Type";
    rdfs:comment "The activity type recorded for this resource.";
    rdfs:domain <http://www.w3.org/ns/prov#Activity>;
    rdfs:range xsd:string.
awp:effectKey a rdf:Property;
    rdfs:label "Effect Key";
    rdfs:comment "The effect key recorded for this resource.";
    rdfs:domain <http://www.w3.org/ns/prov#Activity>;
    rdfs:range xsd:string.
awp:startedAt a rdf:Property;
    rdfs:label "Started At";
    rdfs:comment "The started at recorded for this resource.";
    rdfs:domain <http://www.w3.org/ns/prov#Activity>;
    rdfs:range xsd:dateTime.
awp:endedAt a rdf:Property;
    rdfs:label "Ended At";
    rdfs:comment "The ended at recorded for this resource.";
    rdfs:domain <http://www.w3.org/ns/prov#Activity>;
    rdfs:range xsd:dateTime.
awp:status a rdf:Property;
    rdfs:label "Status";
    rdfs:comment "The status recorded for this resource.";
    rdfs:domain <http://www.w3.org/ns/prov#Activity>;
    rdfs:range xsd:string.
awp:conclusion a rdf:Property;
    rdfs:label "Conclusion";
    rdfs:comment "The conclusion recorded for this resource.";
    rdfs:domain awp:OutcomeRecord;
    rdfs:range awp:OutcomeConclusion.
awp:grant a rdf:Property;
    rdfs:label "Grant";
    rdfs:comment "The grant recorded for this resource.";
