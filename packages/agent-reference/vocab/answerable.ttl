    rdfs:label "Domain";
    rdfs:comment "The domain recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/security#expiration> a rdf:Property;
    rdfs:label "Expires";
    rdfs:comment "The expires recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/security#nonce> a rdf:Property;
    rdfs:label "Nonce";
    rdfs:comment "The one-time challenge value binding the retry to this request.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/security#previousProof> a rdf:Property;
    rdfs:label "Previous Proof";
    rdfs:comment "The previous proof recorded for this resource.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
<https://w3id.org/security#proofPurpose> a rdf:Property;
    rdfs:label "Proof Purpose";
    rdfs:comment "The purpose of the key relationship required by the proof.";
    rdfs:domain rdfs:Resource;
    rdfs:range rdfs:Resource.
