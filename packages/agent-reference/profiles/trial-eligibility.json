  "rules": [
    {
      "id": "urn:rule:trial-eligibility:proof",
      "template": "all-of",
      "params": {
        "inputs": [
          "trial.age",
          "trial.diagnosis",
          "trial.medications",
          "trial.medication-complete"
        ],
        "conditions": [
          {
            "input": "trial.age",
            "operator": "gte",
            "value": 18
          },
          {
            "input": "trial.age",
            "operator": "lte",
            "value": 65
          },
          {
            "input": "trial.diagnosis",
            "operator": "eq",
            "value": "condition-a"
          },
          {
            "input": "trial.medications",
            "operator": "not-in",
            "value": [
              "excluded-x",
              "excluded-y"
            ]
          },
          {
            "input": "trial.medication-complete",
            "operator": "eq",
            "value": true
          }
        ]
      },
      "output": "trial-eligibility.answer",
      "inputsFrom": [
        "urn:fictional:trial-eligibility:practice"
      ],
      "assurances": [
        "attested"
      ],
      "proofQuery": "SELECT DISTINCT ?result WHERE {\n  ?subject <urn:claim:trial.age> ?v0 .        BIND((?v0 >= 18) AS ?test0)\n  ?subject <urn:claim:trial.age> ?v1 .        BIND((?v1 <= 65) AS ?test1)\n  ?subject <urn:claim:trial.diagnosis> ?v2 .  BIND((?v2 = \"condition-a\") AS ?test2)\n  BIND(NOT EXISTS { ?subject <urn:claim:trial.medications> ?excluded3 .\n                    FILTER(?excluded3 IN (\"excluded-x\", \"excluded-y\")) } AS ?test3)\n  ?subject <urn:claim:trial.medication-complete> ?v4 . BIND((?v4 = true) AS ?test4)\n  BIND((?test0 && ?test1 && ?test2 && ?test3 && ?test4) AS ?result)\n}\n"
    }
  ],
