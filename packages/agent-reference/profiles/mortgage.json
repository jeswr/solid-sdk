{
  "$comment": "AUTHORED-BY Codex GPT-6.1-Sol",
  "schema": "agent-profile/0.1",
  "id": "mortgage",
  "claims": [
    {
      "kind": "income.*",
      "sources": [
        "https://paywell.example/#org",
        "https://tax-authority.example/#org"
      ],
      "methods": [
        "recorded-by-authority"
      ],
      "maxAgeDays": 92
    },
    {
      "kind": "deposit.*",
      "sources": [
        "https://harbourbank.example/#org",
        "https://canalbank.example/#org"
      ],
      "methods": [
        "recorded-by-authority"
      ],
      "maxAgeDays": 31
    },
    {
      "kind": "mortgage.decision-in-principle",
      "sources": [
        "https://northbank.example/#org"
      ],
      "methods": [
        "decided-by-authority"
      ],
      "maxAgeDays": 30
    },
    {
      "kind": "mortgage.product",
      "sources": [
        "https://northbank.example/#org",
        "https://harbourbank.example/#org"
      ],
      "methods": [
        "published-by-lender"
      ],
      "maxAgeDays": 31
    },
    {
      "kind": "identity.*",
      "sources": [
        "https://id-provider.example/#org"
      ],
      "methods": [
        "certified-face-check"
      ],
      "maxAgeDays": 1
    }
  ],
  "purposes": [
    {
      "id": "https://w3id.org/jeswr/awp#purpose/mortgage-application",
      "claims": [
        "income.gross.monthly-series",
        "deposit.balance"
      ],
      "partial": false
    },
    {
      "id": "https://w3id.org/jeswr/awp#purpose/credit-assessment",
      "claims": [
        "income.gross.monthly-series",
        "deposit.balance"
      ],
      "partial": false
    },
    {
      "id": "https://w3id.org/jeswr/awp#purpose/product-search",
      "claims": [],
      "partial": true
    }
  ],
  "rules": [
    {
      "id": "deposit-total",
      "reads": [
        "deposit.balance"
      ],
      "produces": "deposit.total",
      "query": "sum(balance) grouped by subject and currency; asOf is the oldest input",
      "complete": [
        "accounts.complete"
      ],
      "assurances": [
        "recomputed",
        "proved",
        "joint"
      ]
    },
    {
      "id": "deposit-at-least",
      "reads": [
        "deposit.balance"
      ],
      "produces": "deposit.at-least",
      "query": "deposit-total >= threshold",
      "complete": [
        "accounts.complete"
      ],
      "assurances": [
        "by-source",
        "proved",
        "joint"
      ]
    },
    {
      "id": "income-annual",
      "reads": [
        "income.gross.monthly-series"
      ],
      "produces": "income.gross.annual",
      "query": "sum(gross) over twelve consecutive months in the stated period",
      "complete": [],
      "assurances": [
        "by-source",
        "recomputed",
        "proved"
      ]
    }
  ],
  "personDecisions": [
    "https://w3id.org/jeswr/awp#op/mortgage-discretion",
    "https://w3id.org/jeswr/awp#op/novel-mortgage-request",
    "https://w3id.org/jeswr/awp#op/mortgage-unknown-term",
    "https://w3id.org/jeswr/awp#op/accept-mortgage-offer"
  ],
  "readingSteps": [
    "product-search"
  ],
  "reliance": {
    "id": "https://w3id.org/jeswr/awp#reliance/mortgage-application",
    "rules": [
      {
        "id": "https://w3id.org/jeswr/awp#reliance/mortgage-application#income",
        "claimType": "income.*",
        "methods": [
          "recorded-by-authority"
        ],
        "maxAgeDays": 92,
        "text": "Income must be recorded by a payroll provider or tax authority and be at most three months old."
      },
      {
        "id": "https://w3id.org/jeswr/awp#reliance/mortgage-application#balance",
        "claimType": "deposit.*",
        "methods": [
          "recorded-by-authority"
        ],
        "maxAgeDays": 31,
        "text": "A balance must be recorded by the bank that holds the account and be at most one month old."
      },
      {
        "id": "https://w3id.org/jeswr/awp#reliance/mortgage-application#decision",
        "claimType": "mortgage.decision-in-principle",
        "methods": [
          "decided-by-authority"
        ],
        "maxAgeDays": 30,
        "text": "A decision in principle must come from the lender itself and still be valid."
      },
      {
        "id": "https://w3id.org/jeswr/awp#reliance/mortgage-application#product",
        "claimType": "mortgage.product",
        "methods": [
          "published-by-lender"
        ],
        "maxAgeDays": 31,
        "text": "A product record must be published by the lender itself and be at most a month old."
      },
      {
        "id": "https://w3id.org/jeswr/awp#reliance/mortgage-application#approval",
        "claimType": "identity.*",
        "methods": [
          "certified-face-check"
        ],
        "maxAgeDays": 1,
        "text": "A stronger approval must be a certified face check made today."
      }
    ]
  },
  "operations": {
    "https://w3id.org/jeswr/awp#op/mortgage-prequalification": {
      "terms": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "const": "https://w3id.org/jeswr/awp#model/mortgage-application"
              },
              "propertyPrice": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 1000000000
              },
              "loanAmount": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 1000000000
              },
              "currency": {
                "type": "string",
                "const": "USD"
              },
              "applicant": {
                "type": "string",
                "maxLength": 512
              },
              "synthetic": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "model",
              "propertyPrice",
              "loanAmount",
              "currency",
              "applicant",
              "synthetic"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "maxLength": 512
              },
              "modelVersion": {
                "type": "string",
                "maxLength": 16
              },
              "application": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "const": "https://w3id.org/jeswr/awp#model/mortgage-application"
                  },
                  "propertyPrice": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 1000000000
                  },
                  "loanAmount": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 1000000000
                  },
                  "currency": {
                    "type": "string",
                    "const": "USD"
                  },
                  "applicant": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "synthetic": {
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": [
                  "model",
                  "propertyPrice",
                  "loanAmount",
                  "currency",
                  "applicant",
                  "synthetic"
                ],
                "additionalProperties": false
              },
              "applicationId": {
                "type": "string",
                "maxLength": 512
              },
              "evidenceRequest": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "claimType": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "periodMonths": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 36
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    }
                  },
                  "required": [
                    "claimType",
                    "periodMonths",
                    "currency"
                  ],
                  "additionalProperties": false
                }
              },
              "purpose": {
                "type": "string",
                "maxLength": 512
              },
              "recipients": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "onward": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "recipient": {
                      "type": "string",
                      "maxLength": 512
                    },
                    "purpose": {
                      "type": "string",
                      "maxLength": 512
                    },
                    "fields": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 64
                      }
                    }
                  },
                  "required": [
                    "recipient",
                    "purpose",
                    "fields"
                  ],
                  "additionalProperties": false
                }
              },
              "retentionDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3650
              },
              "prohibitedPurposes": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "fee": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number",
                    "const": 0
                  }
                },
                "required": [
                  "amount"
                ],
                "additionalProperties": false
              },
              "synthetic": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "model",
              "modelVersion",
              "application",
              "applicationId",
              "evidenceRequest",
              "purpose",
              "recipients",
              "onward",
              "retentionDays",
              "prohibitedPurposes",
              "fee",
              "synthetic"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "https://w3id.org/jeswr/awp#op/mortgage-product-search": {
      "input": {
        "type": "object",
        "properties": {
          "propertyUse": {
            "type": "string"
          },
          "rateType": {
            "type": "string"
          }
        },
        "required": [
          "propertyUse",
          "rateType"
        ],
        "additionalProperties": false
      }
    },
    "https://w3id.org/jeswr/awp#op/balance-statement": {
      "input": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          },
          "asOf": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "account",
          "asOf"
        ],
        "additionalProperties": false
      }
    }
  }
}
