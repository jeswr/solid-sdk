# AUTHORED-BY Codex GPT-6.1-Sol
# Read profile derived from sectors/health/health.shacl.ttl and pkg-memory templates.
# This is a projection, not a clinical conformance validator. Changes from the sector:
# - Only Condition, MedicationStatement, MedicinalProduct, Observation, Immunization,
#   Encounter and CodeableConcept are retained; external FHIR AllergyIntolerance is added.
#   HealthRecord, ClinicalEntry, Patient/care-team roles, vital subtypes and clinical
#   activity shapes, aggregation/custodian/IDMP constraints are outside this reader.
# - All projected fields are optional singletons (maxCount 1): incomplete historical
#   assertions remain visible. Sector minCount/class constraints are omitted: PKG
#   templates do not type patients as core:Person or require codes, units or dates.
# - Linked records are read separately, without sh:class/composite validation.
# - schema:name, schema subject aliases, skos:exactMatch are PKG read additions.
# - Canonical classes accept legacy type aliases; Condition also accepts MedicalCondition,
#   MedicinalProduct accepts Drug, Observation accepts FHIR/schema Observation.
# - Shared patient/hasCode/medication predicates stay canonical in this model. Generator
#   admission forbids their aliases across owners. The facade's typed read view provides
#   canonical-first legacy reads plus FHIR/schema subject links and rdfs:label fallback.
# - Mixed XSD temporal bounds (date/dateTime/gYearMonth/gYear), observation numeric/string
#   values and effectiveTime (literal or OWL-Time resource) cannot be represented by this
#   closed profile. The typed read view handles them without coercing lexical values.
# - schema:doseSchedule and schema:code are omitted: BlankNodeOrIRI records are not
#   admitted. The typed view reads their typed fields, including skolemized records.
# - CodeableConcept core:value is narrowed to string (as written by PKG templates);
#   core:inScheme is omitted in favour of the PKG skos:exactMatch code IRI.
# See README Generator gaps for the complete compatibility contract.
@prefix health: <https://jeswr.org/ns/sectors/health#> .
@prefix old: <https://w3id.org/jeswr/sectors/health#> .
@prefix core: <https://jeswr.org/ns/core#> .
@prefix oldcore: <https://w3id.org/jeswr/core#> .
@prefix shape: <https://jeswr.org/ns/pkg-health/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix fhir: <http://hl7.org/fhir/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:Condition a sh:NodeShape ;
  sh:targetClass health:Condition, old:Condition, schema:MedicalCondition ;
  sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:patient ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:hasCode ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] .

shape:MedicationStatement a sh:NodeShape ;
  sh:targetClass health:MedicationStatement, old:MedicationStatement ;
  sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:patient ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:hasCode ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:medication ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] .

shape:MedicinalProduct a sh:NodeShape ;
  sh:targetClass health:MedicinalProduct, old:MedicinalProduct, schema:Drug ;
  sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Info ] .

shape:Observation a sh:NodeShape ;
  sh:targetClass health:Observation, old:Observation, fhir:Observation, schema:Observation ;
  sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:patient ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:hasCode ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path [ sh:alternativePath ( health:hasUnit old:hasUnit ) ] ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path [ sh:alternativePath ( health:unitCode old:unitCode ) ] ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Info ] .

shape:Immunization a sh:NodeShape ;
  sh:targetClass health:Immunization, old:Immunization ;
  sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:patient ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:hasCode ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:medication ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] .

shape:Encounter a sh:NodeShape ;
  sh:targetClass health:Encounter, old:Encounter ;
  sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:patient ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:hasCode ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path [ sh:alternativePath ( health:recordedBy old:recordedBy ) ] ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] .

shape:CodeableConcept a sh:NodeShape ;
  sh:targetClass health:CodeableConcept, old:CodeableConcept ;
  sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path [ sh:alternativePath ( core:value oldcore:value ) ] ; sh:name "codeValue" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path skos:exactMatch ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] .

shape:AllergyIntolerance a sh:NodeShape ;
  sh:targetClass fhir:AllergyIntolerance ;
  sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:patient ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] ;
  sh:property [ sh:path health:hasCode ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info ] .
