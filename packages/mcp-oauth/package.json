{
  "$comment": "AUTHORED-BY Codex GPT-6.1-Sol",
  "name": "@jeswr/mcp-oauth",
  "version": "0.1.0",
  "private": true,
  "description": "Resource-bound OAuth authorization server for MCP. Experimental, AI-agent-generated.",
  "type": "module",
  "sideEffects": false,
  "securityCritical": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
