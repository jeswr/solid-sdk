    "@rdfjs/wrapper": "^0.34.0",
    "n3": "^2.1.1",
    "openid-client": "^6.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
