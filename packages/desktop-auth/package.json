{
  "$comment": "AUTHORED-BY Claude Opus 5.5",
  "name": "@jeswr/desktop-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop (Tauri, Electron) Solid-OIDC sign-in: system browser plus a private-use scheme deep link, as pod-auth's ui.getCode, and the native Client Identifier Document. Experimental, AI-agent-generated.",
  "type": "module",
  "sideEffects": false,
  "securityCritical": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@jeswr/suite-native": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@jeswr/pod-auth": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
