{
  "name": "@jeswr/agent-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Policy sandbox for agents (IDEA programme): one fail-closed gate that holds an LLM tool loop, generated code or any MCP client to global ODRL mandates plus the ODRL policies attached to the data it reads, with send-rate limits, approvals and a hash-chained decision record.",
  "type": "module",
  "license": "MIT",
  "x-authored-by": "Claude Opus 5.5",
  "sideEffects": false,
  "securityCritical": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "default": "./dist/world/index.js"
    },
    "./code": {
      "types": "./dist/runners/code.d.ts",
      "default": "./dist/runners/code.js"
    },
    "./mcp": {
      "types": "./dist/mcp/proxy.d.ts",
      "default": "./dist/mcp/proxy.js"
    }
  },
  "bin": {
    "agent-sandbox-mcp": "./dist/mcp/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "pnpm -w exec tsc -p packages/agent-sandbox/tsconfig.json",
    "typecheck": "pnpm -w exec tsc -p packages/agent-sandbox/tsconfig.json --noEmit && pnpm -w exec tsc -p packages/agent-sandbox/tsconfig.test.json",
    "lint": "pnpm -w exec biome check packages/agent-sandbox",
    "test": "pnpm -w exec vitest run --root packages/agent-sandbox --coverage"
  },
  "dependencies": {
    "@jeswr/agent-mandate": "workspace:*",
    "@jeswr/agent-model": "workspace:*",
    "@jeswr/solid-odrl": "workspace:*",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "quickjs-emscripten-core": "^0.32.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.10",
    "zod": "^4.4.3"
  }
}
