{
  "shapesBase": "https://w3id.org/jeswr/sectors/scheduling/shapes#",
  "prefixes": {
    "sched": "https://w3id.org/jeswr/sectors/scheduling#",
    "core": "https://w3id.org/jeswr/core#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "jsched": "https://jeswr.org/ns/sectors/scheduling#",
    "schema": "https://schema.org/",
    "dct": "http://purl.org/dc/terms/"
  },
  "entities": [
    {
      "name": "Task",
      "kind": "composite",
      "root": "task",
      "nodes": {
        "task": {
          "targetClass": "https://w3id.org/jeswr/sectors/scheduling#Task",
          "fragment": "it",
          "fields": {
            "summary": {},
            "description": {
              "emptyStringDrop": true
            },
            "startTime": {},
            "dueTime": {},
            "completed": {},
            "completedAt": {},
            "organizer": {
              "iriScheme": "http-https"
            },
            "inCalendar": {
              "rename": "calendar",
              "iriScheme": "http-https"
            }
          },
          "links": {
            "recurrence": "recurrence"
          }
        },
        "recurrence": {
          "targetClass": "https://w3id.org/jeswr/sectors/scheduling#RecurrenceRule",
          "fragment": "recurrence",
          "fields": {
            "frequency": {},
            "interval": {},
            "count": {},
            "until": {}
          }
        }
      }
    },
    {
      "targetClass": "https://w3id.org/jeswr/sectors/scheduling#Calendar",
      "name": "Calendar",
      "subject": {
        "convention": "hash-it"
      },
      "fields": {
        "description": {
          "emptyStringDrop": true
        },
        "organizer": {
          "iriScheme": "http-https"
        }
      }
    },
    {
      "targetClass": "https://jeswr.org/ns/sectors/scheduling#Calendar",
      "name": "CalendarDocument",
      "subject": {
        "convention": "hash-it"
      }
    },
    {
      "targetClass": "https://jeswr.org/ns/sectors/scheduling#CalendarEvent",
      "name": "CalendarEvent",
      "subject": {
        "convention": "hash-it"
      },
      "fields": {
        "name": {
          "sanitizeText": false
        },
        "timeZone": {
          "sanitizeText": false
        },
        "uid": {
          "sanitizeText": false
        }
      }
    }
  ]
}
