{
  "name": "@jeswr/solid-mail",
  "version": "0.1.0",
  "description": "Generated RDF mail model: live message, thread, folder and attachment wrappers with mailbox document helpers.",
  "type": "module",
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/solid-sdk.git",
    "directory": "packages/solid-mail"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./message": {
      "types": "./dist/message.d.ts",
      "import": "./dist/message.js"
    },
    "./thread": {
      "types": "./dist/thread.d.ts",
      "import": "./dist/thread.js"
    },
    "./folder": {
      "types": "./dist/folder.d.ts",
      "import": "./dist/folder.js"
    },
    "./attachment": {
      "types": "./dist/attachment.d.ts",
      "import": "./dist/attachment.js"
    },
    "./mailbox": {
      "types": "./dist/mailbox.d.ts",
      "import": "./dist/mailbox.js"
    },
    "./serialise": {
      "types": "./dist/serialise.d.ts",
      "import": "./dist/serialise.js"
    },
    "./vocab": {
      "types": "./dist/vocab.d.ts",
      "import": "./dist/vocab.js"
    }
  },
  "files": [
    "dist",
    "codegen",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-generated.mjs",
    "codegen": "node node_modules/@jeswr/federation-codegen/dist/cli.js gen --ontology codegen/mail.ontology.ttl --shapes codegen/mail.shapes.ttl --config codegen/codegen.config.json --out src/generated",
    "lint": "biome check src scripts test codegen/codegen.config.json package.json",
    "lint:fix": "biome check --write src scripts test codegen/codegen.config.json package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jeswr/fetch-rdf": "workspace:*",
    "@jeswr/model-runtime": "workspace:*",
    "@rdfjs/wrapper": "^0.34.0",
    "n3": "^2.0.3"
  },
  "peerDependencies": {
    "@rdfjs/types": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@jeswr/federation-codegen": "workspace:*",
    "@jeswr/pod-connectors": "workspace:*",
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.1",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  },
  "securityCritical": false
}
