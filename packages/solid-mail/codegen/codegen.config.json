{
  "shapesBase": "https://jeswr.org/ns/mail/shapes#",
  "prefixes": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "http://schema.org/",
    "sioc": "http://rdfs.org/sioc/ns#",
    "dct": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "solid": "http://www.w3.org/ns/solid/terms#",
    "ldp": "http://www.w3.org/ns/ldp#"
  },
  "entities": [
    {
      "name": "Message",
      "targetClass": "http://schema.org/EmailMessage",
      "subject": {
        "convention": "self"
      },
      "fields": {
        "subjectLine": {
          "sanitizeText": false
        },
        "body": {
          "sanitizeText": false
        },
        "bodyHtml": {
          "sanitizeText": false
        },
        "identifier": {
          "sanitizeText": false
        }
      }
    },
    {
      "name": "Thread",
      "targetClass": "http://schema.org/Conversation",
      "subject": {
        "convention": "self"
      },
      "fields": {
        "title": {
          "sanitizeText": false
        }
      }
    },
    {
      "name": "Folder",
      "targetClass": "http://schema.org/Collection",
      "subject": {
        "convention": "self"
      },
      "fields": {
        "title": {
          "sanitizeText": false
        }
      }
    },
    {
      "name": "Attachment",
      "targetClass": "http://schema.org/MediaObject",
      "subject": {
        "convention": "self"
      },
      "fields": {
        "name": {
          "sanitizeText": false
        },
        "contentType": {
          "sanitizeText": false
        }
      }
    }
  ]
}
