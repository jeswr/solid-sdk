{
  "name": "@jeswr/suite-ui",
  "version": "0.1.0",
  "description": "Solid Suite normative design tokens, theme mapping, density and Next.js fonts",
  "type": "module",
  "license": "MIT",
  "securityCritical": false,
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/theme.css": "./dist/styles/theme.css",
    "./styles/density.css": "./dist/styles/density.css",
    "./styles/components.css": "./dist/styles/components.css",
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./styles/shell.css": "./dist/styles/shell.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "lint": "biome check src test scripts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "next": "16.2.7",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "@biomejs/biome": "^2.5.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/dom": "10.4.1",
    "jsdom": "29.1.1",
    "axe-core": "4.14.0"
  },
  "dependencies": {
    "radix-ui": "1.6.2",
    "lucide-react": "1.24.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "cmdk": "1.1.1",
    "sonner": "2.0.7",
    "next-themes": "0.4.6",
    "react-day-picker": "9.14.0",
    "react-resizable-panels": "4.15.0",
    "react-hook-form": "7.81.0",
    "zod": "4.4.3",
    "@hookform/resolvers": "5.4.0"
  }
}
