{
  "name": "@jeswr/suite-vocab",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical IRI constants and legacy namespace aliases for the Solid suite",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "securityCritical": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
