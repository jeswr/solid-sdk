{
  "$comment": "AUTHORED-BY Claude Sonnet 5.5",
  "name": "@jeswr/pod-media-loader",
  "version": "0.1.0",
  "description": "Show authenticated pod media safely in a browser or webview: scoped bounded reads through a StorageClient, magic-byte sniffing against an allowlist, sniffed-type-only blob object URLs, reference counting, ETag freshness and purge on sign-out. Experimental, AI-agent-generated.",
  "type": "module",
  "sideEffects": false,
  "securityCritical": true,
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/pod-media-loader.git"
  },
  "keywords": [
    "solid",
    "pod",
    "blob",
    "object-url",
    "media",
    "sniffing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check src test package.json",
    "lint:fix": "biome check --write src test package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jeswr/guarded-fetch": "workspace:*",
    "@jeswr/storage-client": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
