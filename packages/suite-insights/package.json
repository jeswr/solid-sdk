{
  "name": "@jeswr/suite-insights",
  "version": "0.1.0",
  "description": "Pure calendar-aware exploratory analysis of personal time series",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "securityCritical": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --workspace-root exec tsc -p packages/suite-insights/tsconfig.json",
    "typecheck": "pnpm --workspace-root exec tsc -p packages/suite-insights/tsconfig.json --noEmit",
    "lint": "pnpm --workspace-root exec biome check packages/suite-insights",
    "test": "pnpm --workspace-root exec vitest run --root packages/suite-insights --coverage"
  },
  "dependencies": {
    "@jeswr/suite-charts": "workspace:*"
  }
}
