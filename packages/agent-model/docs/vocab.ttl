    rdfs:label "supportsBinding".
agent:supportsOperation rdfs:comment "An operation the agent supports.";
    rdfs:label "supportsOperation".
agent:target rdfs:comment "Target operation or resource of the action.";
    rdfs:label "target".
agent:termsDigest rdfs:comment "JCS/SHA-256 digest of the exact terms.";
    rdfs:label "termsDigest".
agent:triage rdfs:comment "Whether account messages may be triaged; false by default.";
    rdfs:label "triage".
agent:underApproval rdfs:comment "Approval that the executor evaluated for this transmission.";
    rdfs:label "underApproval".
agent:underMandate rdfs:comment "Links an autonomous action to the signed mandate that authorized it (prov:hadPlan-adjacent).";
    rdfs:label "underMandate".
agent:validFrom rdfs:comment "Beginning of mandate credential validity.";
    rdfs:label "validFrom".
agent:validUntil rdfs:comment "End of validity (exclusive), xsd:dateTime.";
    rdfs:label "validUntil".
<https://jeswr.org/ns/agent#verification/invalid> rdfs:comment "invalid value in the verification concept scheme; an evidence classification, not a grant.";
    rdfs:label "verification/invalid".
<https://jeswr.org/ns/agent#verification/not-applicable> rdfs:comment "not-applicable value in the verification concept scheme; an evidence classification, not a grant.";
    rdfs:label "verification/not-applicable".
<https://jeswr.org/ns/agent#verification/unknown-key> rdfs:comment "unknown-key value in the verification concept scheme; an evidence classification, not a grant.";
    rdfs:label "verification/unknown-key".
<https://jeswr.org/ns/agent#verification/unsupported> rdfs:comment "unsupported value in the verification concept scheme; an evidence classification, not a grant.";
    rdfs:label "verification/unsupported".
<https://jeswr.org/ns/agent#verification/valid> rdfs:comment "valid value in the verification concept scheme; an evidence classification, not a grant.";
    rdfs:label "verification/valid".
agent:verificationMaterial rdfs:comment "Pinned key thumbprint (RFC 7638) used.";
    rdfs:label "verificationMaterial".
agent:verificationOutcome rdfs:comment "A concept from agent:VerificationOutcomes.";
    rdfs:label "verificationOutcome".
agent:wireDigest rdfs:comment "Digest of the exact rendered channel bytes.";
    rdfs:label "wireDigest".
agent:wireFormat rdfs:comment "Protection format of a signed message envelope.";
    rdfs:label "wireFormat".
agent:withApproval rdfs:comment "Policy set requiring a matching verified owner approval.";
    rdfs:label "withApproval".
