        "revocation": "NSS 6.0.0 (@solid/oidc-op) advertises no revocation_endpoint in its discovery document (observed 2026-09-27)"
      },
      "knownIncompatible": {
        "solid.login": {
          "reason": "NSS 6.0.0 issues ID tokens without the nonce claim the client sent (OpenID Connect Core §3.1.3.7 requires it); the library validates it strictly for every issuer except the two hosted NSS deployments in its upstream quirk list (datapod.igrant.io, solidweb.org)",
          "signature": "JWT \"nonce\" \\(nonce\\) claim missing"
        }
      }
