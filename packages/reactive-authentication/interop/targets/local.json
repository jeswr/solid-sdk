        "storageDiscovery": "the storage root is typed pim:Storage, but its storage description Link uses rel http://www.w3.org/ns/solid#storageDescription rather than the Solid Protocol's http://www.w3.org/ns/solid/terms#storageDescription; not observable end to end while authentication cannot start"
      },
      "knownIncompatible": {
        "solid.login": {
          "reason": "Solid Nextcloud answers unauthenticated GET, HEAD and PUT requests to protected resources with 403 and no WWW-Authenticate challenge (observed 2026-09-27). The Solid Protocol (HTTP Server) requires 401 when a request lacks valid credentials for a resource that needs them (404 is allowed for security reasons); this library authenticates reactively, only after a 401 challenge, so no login can start",
          "signature": "answered an unauthenticated request to a protected resource with 403 and no 401/WWW-Authenticate challenge"
        }
      }
