    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/reactive-authentication-ai.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run test:types && node --test --test-concurrency=1 test/*.test.js",
    "test:browser": "npm run build && node test/browser/run.js",
    "docs": "typedoc",
    "check": "npm test && npm run test:browser && npm pack --dry-run && npm audit --omit=dev --audit-level=moderate",
    "test:types": "tsc -p test/types"
  },
  "license": "MIT",
  "dependencies": {
    "@key-value-kit/core": "0.1.0-alpha.0",
