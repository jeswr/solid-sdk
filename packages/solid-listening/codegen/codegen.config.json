{
  "shapesBase": "https://w3id.org/jeswr/sectors/media/shapes#",
  "prefixes": {
    "media": "https://w3id.org/jeswr/sectors/media#",
    "core": "https://w3id.org/jeswr/core#",
    "time": "http://www.w3.org/2006/time#",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "dcterms": "http://purl.org/dc/terms/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "jmedia": "https://jeswr.org/ns/sectors/media#",
    "jcore": "https://jeswr.org/ns/core#",
    "schema": "https://schema.org/"
  },
  "entities": [
    {
      "name": "Scrobble",
      "kind": "composite",
      "root": "event",
      "nodes": {
        "event": {
          "targetClass": "https://w3id.org/jeswr/sectors/media#PlaybackEvent",
          "fragment": "it",
          "fields": { "msPlayed": {} },
          "links": { "playedWork": "track", "atTime": "playedAt" }
        },
        "track": {
          "targetClass": "https://w3id.org/jeswr/sectors/media#Track",
          "fragment": "track",
          "fields": {
            "title": { "rename": "trackTitle" },
            "durationSeconds": {},
            "isrc": {}
          },
          "links": { "performedByArtist": "artist", "inAlbum": "album" }
        },
        "playedAt": {
          "targetClass": "http://www.w3.org/2006/time#Instant",
          "fragment": "playedAt",
          "fields": { "inXSDDateTime": { "rename": "playedAt" } }
        },
        "artist": {
          "targetClass": "https://w3id.org/jeswr/sectors/media#Artist",
          "fragment": "artist",
          "fields": { "name": { "rename": "artistName" } }
        },
        "album": {
          "targetClass": "https://w3id.org/jeswr/sectors/media#Album",
          "fragment": "album",
          "fields": { "title": { "rename": "albumTitle" } }
        }
      }
    },
    {
      "name": "LibraryTrack",
      "targetClass": "https://jeswr.org/ns/sectors/media#Track",
      "subject": { "convention": "self" },
      "fields": {
        "title": { "sanitizeText": false },
        "name": { "sanitizeText": false },
        "duration": { "sanitizeText": false },
        "isrc": { "sanitizeText": false }
      }
    },
    {
      "name": "LibraryArtist",
      "targetClass": "https://jeswr.org/ns/sectors/media#Artist",
      "subject": { "convention": "self" },
      "fields": { "foafName": { "sanitizeText": false }, "name": { "sanitizeText": false } }
    },
    {
      "name": "LibraryAlbum",
      "targetClass": "https://jeswr.org/ns/sectors/media#Album",
      "subject": { "convention": "self" },
      "fields": { "title": { "sanitizeText": false }, "name": { "sanitizeText": false } }
    },
    {
      "name": "LibraryPlaylist",
      "targetClass": "https://jeswr.org/ns/sectors/media#Playlist",
      "subject": { "convention": "self" },
      "fields": { "title": { "sanitizeText": false }, "name": { "sanitizeText": false } }
    },
    {
      "name": "Listen",
      "targetClass": "https://jeswr.org/ns/sectors/media#PlaybackEvent",
      "subject": { "convention": "self" }
    }
  ]
}
