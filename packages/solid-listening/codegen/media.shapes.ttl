    ] .

lib:ListenShape
    a sh:NodeShape ;
    sh:targetClass jmedia:PlaybackEvent ;
    sh:property [
        sh:path jmedia:playedWork ;
        sh:name "playedWork" ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path schema:object ;
        sh:name "listenedTo" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path jcore:atTime ;
        sh:name "atTime" ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path schema:startTime ;
        sh:name "startTime" ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:endTime ;
        sh:name "endTime" ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path jcore:hadParticipant ;
        sh:name "hadParticipant" ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path schema:agent ;
        sh:name "agent" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path jmedia:msPlayed ;
        sh:name "msPlayed" ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ; sh:minInclusive 0 ;
        sh:severity sh:Info ;
    ] .
