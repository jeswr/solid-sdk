# AUTHORED-BY Claude Opus 4.8
# AUTHORED-BY Claude Opus 5.5 (Suite Music library profile)
#
# Generation INPUT (SHACL profile, L2) for @jeswr/solid-listening's generated model.
#
# The FIVE scrobble-relevant NodeShapes of the media sector
# (solid-federation-vocab @ 3fba46e sectors/media/media.shacl.ttl) —
# PlaybackEvent / Track / PlayedAtInstant (time:Instant) / Artist / Album —
# copied VERBATIM (sh:path/nodeKind/class/datatype/cardinality/minInclusive/
# maxInclusive/minLength/pattern/severity preserved). sh:message + rdfs:label are
# dropped (they do not drive codegen). This is a faithful SUBSET of the sector
# profile: only the shapes the scrobble composite spans, so the generator has a
# codegen config for every compiled shape. A reproduce test regenerates from these
# inputs and diffs the committed src/generated, guarding drift.
#
# Two sector constraints are deliberately left out because the generator's closed
# admission has no reviewed runtime guard for them, and neither the hand-written
# model nor the July generated model enforced them:
#   - media:isrc sh:pattern "^[A-Z]{2}[A-Z0-9]{3}[0-9]{2}[0-9]{5}$" (Warning);
#   - the media:playedVia property (sh:nodeKind sh:BlankNodeOrIRI, Info), which the
#     composite does not project.
# The ISRC pattern stays in the published listening.shacl.ttl, which src/shape.test.ts
# validates with rdf-validate-shacl; listening.shacl.ttl never constrained playedVia.
# Reviewed pattern support is tracked as a follow-up bead (sst-ild.4.11).
#
# media:playedWork is narrowed from the sector's sh:class media:CreativeWork to
# media:Track, matching this package's published listening.shacl.ttl: the generator
# links class-only constraints to exactly-matching shapes, and sh:class is checked
# against the data graph, where a scrobble's track is typed media:Track.
#
# ---------------------------------------------------------------------------------
# Suite Music library profile (AUTHORED-BY Claude Opus 5.5; bead sst-urdp).
#
# Five FLAT entities (subject convention "self": one subject per track, artist, album,
# playlist or play, many per document) describing exactly what the Suite Music app
# writes to pods, so the app's canonical writes go through the generated model. The
# shapes start from the same sector shapes, under the sector's jeswr.org namespace
# (`jmedia:` / `jcore:`, https://jeswr.org/ns/…) that the app has always written; its
# on-pod IRIs are kept exactly. Mappings and narrowings, each deliberate:
#   - Additive schema.org mirrors the app writes beside the sector term (the app
#     dual-writes both): schema:name beside dcterms:title / foaf:name, schema:byArtist
#     beside media:performedByArtist, schema:inAlbum beside media:inAlbum,
#     schema:duration (an ISO "PT…S" xsd:string, the app's historic form) beside
#     media:durationSeconds, schema:object beside media:playedWork, schema:startTime
#     beside core:atTime, schema:agent beside core:hadParticipant. They are distinct
#     canonical fields, not read aliases: aliases are migrated away on write, and the
#     app keeps both terms on the pod.
#   - App-only fields: schema:url, schema:image, schema:contentUrl, schema:lyrics,
#     schema:track (album track list) and schema:endTime; artist/album/playlist also
#     carry the byArtist / performedByArtist / url / image fields because every app
#     entity accepts them.
#   - Sector sh:class hints on IRI links (performedByArtist → Artist, inAlbum → Album,
#     playedWork → media:Track, hadParticipant → core:Agent, atTime → time:Instant)
#     are omitted: flat fields cannot carry class hints, and the app links to
#     resources in other documents whose types it cannot see.
#   - The ISRC sh:pattern is omitted (as for the scrobble composite above), and the
#     isrc property is graded sh:Info rather than the sector's sh:Warning.
#   - Listen omits the sector's onAccount, completionFraction and loved properties
#     (the app does not write them on a play).
#   - codegen.config.json sets sanitizeText false on the library text fields, so
#     titles are written exactly as given (the app's historic behaviour).
#   - core:hadParticipant is narrowed to sh:maxCount 1 (the app writes one listener).
#   - No IRI field carries an ^https?:// pattern: the runtime scheme guard normalizes
#     IRIs, and the app keeps exact lexical identities (it validates http(s) itself).
#   - The schema.org second type (schema:MusicRecording, schema:MusicGroup,
#     schema:MusicAlbum, schema:MusicPlaylist, schema:ListenAction) is a co-type added by
#     the facade (src/library.ts), not a type alias, which mark() would remove.
#   - Playlist entries (blank schema:ListItem nodes with schema:position + schema:item)
#     are not modelled: generated wrappers address named subjects only.
#   - Play instants reuse the composite's PlayedAtInstantShape node (time:Instant).
# Read tolerance for foreign and legacy data (mo:, http://schema.org/, w3id.org media,
# untyped literals) stays in the app; see README "Suite Music library".
@prefix mdsh:    <https://w3id.org/jeswr/sectors/media/shapes#> .
@prefix media:   <https://w3id.org/jeswr/sectors/media#> .
@prefix core:    <https://w3id.org/jeswr/core#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix jmedia:  <https://jeswr.org/ns/sectors/media#> .
@prefix jcore:   <https://jeswr.org/ns/core#> .
@prefix schema:  <https://schema.org/> .
@prefix lib:     <https://jeswr.org/ns/sectors/media/shapes#> .

mdsh:PlaybackEventShape
    a sh:NodeShape ;
    sh:targetClass media:PlaybackEvent ;
    sh:property [
        sh:path media:playedWork ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class media:Track ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path core:hadParticipant ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:class core:Agent ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path core:atTime ;
        sh:nodeKind sh:IRI ;
        sh:class time:Instant ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path media:onAccount ;
        sh:class media:MediaAccount ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path media:msPlayed ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path media:completionFraction ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path media:loved ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] .

mdsh:TrackShape
    a sh:NodeShape ;
    sh:targetClass media:Track ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:pattern "\\S" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path media:performedByArtist ;
        sh:nodeKind sh:IRI ;
        sh:class media:Artist ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path media:inAlbum ;
        sh:nodeKind sh:IRI ;
        sh:class media:Album ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path media:durationSeconds ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path media:isrc ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] .

mdsh:PlayedAtInstantShape
    a sh:NodeShape ;
    sh:targetClass time:Instant ;
    sh:property [
        sh:path time:inXSDDateTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

mdsh:ArtistShape
    a sh:NodeShape ;
    sh:targetClass media:Artist ;
    sh:property [
        sh:path foaf:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] .

mdsh:AlbumShape
    a sh:NodeShape ;
    sh:targetClass media:Album ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
    ] .

lib:LibraryTrackShape
    a sh:NodeShape ;
    sh:targetClass jmedia:Track ;
    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:pattern "\\S" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:name "name" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:byArtist ;
        sh:name "byArtist" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path jmedia:performedByArtist ;
        sh:name "performedByArtist" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:name "url" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:image ;
        sh:name "image" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path jmedia:inAlbum ;
        sh:name "inAlbum" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:inAlbum ;
        sh:name "schemaInAlbum" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path jmedia:durationSeconds ;
        sh:name "durationSeconds" ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ; sh:minInclusive 0 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:duration ;
        sh:name "duration" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path jmedia:loved ;
        sh:name "loved" ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path jmedia:isrc ;
        sh:name "isrc" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:contentUrl ;
        sh:name "contentUrl" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:lyrics ;
        sh:name "lyrics" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] .

lib:LibraryArtistShape
    a sh:NodeShape ;
    sh:targetClass jmedia:Artist ;
    sh:property [
        sh:path foaf:name ;
        sh:name "foafName" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:name "name" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:byArtist ;
        sh:name "byArtist" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
