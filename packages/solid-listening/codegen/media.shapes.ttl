lib:LibraryAlbumShape
    a sh:NodeShape ;
    sh:targetClass jmedia:Album ;
    sh:property [
        sh:path dcterms:title ;
        sh:name "title" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:name "name" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:byArtist ;
        sh:name "byArtist" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path jmedia:performedByArtist ;
        sh:name "performedByArtist" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:name "url" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path schema:image ;
