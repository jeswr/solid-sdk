{
  "name": "@jeswr/pod-ask",
  "version": "0.1.0",
  "description": "Pure, bounded prompts and citation-aware answers over retrieved pod passages.",
  "type": "module",
  "license": "MIT",
  "x-authored-by": "Codex (GPT-6.1 Sol)",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm -w exec tsc -p packages/pod-ask/tsconfig.json",
    "typecheck": "pnpm -w exec tsc -p packages/pod-ask/tsconfig.json --noEmit && pnpm -w exec tsc -p packages/pod-ask/tsconfig.test.json",
    "lint": "pnpm -w exec biome check packages/pod-ask",
    "test": "pnpm -w exec vitest run --root packages/pod-ask"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
