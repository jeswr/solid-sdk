{
  "manifestVersion": 1,
  "runtime": {
    "name": "@jeswr/model-runtime",
    "major": 0
  },
  "prefixes": {
    "journal": "https://jeswr.org/ns/journal#",
    "schema": "http://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "entities": [
    {
      "name": "Entry",
      "typeIris": [
        "https://jeswr.org/ns/journal#Entry"
      ],
      "subject": {
        "convention": "hash-it"
      },
      "fields": [
        {
          "name": "text",
          "predicate": "http://schema.org/articleBody",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true,
            "nonBlank": true
          }
        },
        {
          "name": "created",
          "predicate": "http://schema.org/dateCreated",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#dateTime",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "modified",
          "predicate": "http://schema.org/dateModified",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#dateTime",
          "maxCount": 1,
          "guards": {}
        },
        {
          "name": "title",
          "predicate": "http://schema.org/headline",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "maxCount": 1,
          "guards": {}
        },
        {
          "name": "images",
          "predicate": "http://schema.org/image",
          "kind": "iri",
          "collection": "set",
          "guards": {
            "iriScheme": "http-https",
            "iriPattern": "http-https"
          }
        },
        {
          "name": "tags",
          "predicate": "http://schema.org/keywords",
          "kind": "literal",
          "collection": "set",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "guards": {
            "trim": true,
            "dropBlank": true,
            "sortOnRead": true
          }
        },
        {
          "name": "location",
          "predicate": "http://schema.org/locationCreated",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "maxCount": 1,
          "guards": {}
        },
        {
          "name": "mood",
          "predicate": "https://jeswr.org/ns/journal#mood",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "maxCount": 1,
          "in": [
            "awful",
            "bad",
            "okay",
            "good",
            "great"
          ],
          "guards": {}
        },
        {
          "name": "weather",
          "predicate": "https://jeswr.org/ns/journal#weather",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "maxCount": 1,
          "guards": {}
        }
      ]
    }
  ]
}
