# Supply-chain hardening (suite default — prod-solid-server ADR-0011): disable
# npm install/lifecycle scripts so no fetched package can run a
# postinstall/preinstall/prepare payload. Consumers installing this package via
# `npm install github:jeswr/personal-agent#<sha>` therefore need NO build step —
# the built `dist/` is committed (see README + scripts/check-dist.mjs), and every
# @jeswr git dependency likewise ships its own committed `dist/`.
ignore-scripts=true
