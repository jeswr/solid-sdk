# AUTHORED-BY Codex (GPT-6.1 Sol)
# No travel sector exists in solid-federation-vocab. This is a new schema.org profile.
# Narrowings: singleton IRI-linked children, xsd:string names/addresses, IRI statuses.
# PostalAddress objects and literal providers are omitted (no datatype/node union).
# Links are singleton IRI fields. Shared child classes cannot be reused in composites;
# flat generated wrappers are joined by the facade, without requiring child rdf:type.
@prefix schema: <http://schema.org/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix trips: <https://jeswr.org/ns/trips#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
trips:TripShape a sh:NodeShape ; sh:targetClass schema:Trip ;
 sh:property [ sh:path schema:name ; sh:name "name" ; sh:datatype xsd:string ; sh:pattern "\\S" ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:startDate ; sh:name "startDate" ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:endDate ; sh:name "endDate" ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:touristDestination ; sh:name "destination" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:description ; sh:name "notes" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:image ; sh:name "cover" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:subjectOf ; sh:name "reservations" ; sh:nodeKind sh:IRI ] ;
 sh:property [ sh:path dct:created ; sh:name "created" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
 sh:property [ sh:path dct:modified ; sh:name "modified" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
 sh:property [ sh:path trips:archived ; sh:name "archived" ; sh:datatype xsd:boolean ; sh:maxCount 1 ] .
trips:OrganizationShape a sh:NodeShape ; sh:targetClass schema:Organization ;
 sh:property [ sh:path schema:name ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ] .
trips:PersonShape a sh:NodeShape ; sh:targetClass schema:Person ;
 sh:property [ sh:path schema:name ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ] .
trips:AirportShape a sh:NodeShape ; sh:targetClass schema:Airport ;
 sh:property [ sh:path schema:iataCode ; sh:name "iataCode" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:name ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ] .
trips:PlaceShape a sh:NodeShape ; sh:targetClass schema:Place ;
 sh:property [ sh:path schema:name ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:address ; sh:name "address" ; sh:datatype xsd:string ; sh:maxCount 1 ] .
trips:FlightShape a sh:NodeShape ; sh:targetClass schema:Flight ;
 sh:property [ sh:path schema:flightNumber ; sh:name "number" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:departureTime ; sh:name "start" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:arrivalTime ; sh:name "end" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:departureAirport ; sh:name "from" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:arrivalAirport ; sh:name "to" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .
trips:TrainTripShape a sh:NodeShape ; sh:targetClass schema:TrainTrip ;
 sh:property [ sh:path schema:trainNumber ; sh:name "number" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:departureTime ; sh:name "start" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:arrivalTime ; sh:name "end" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:departureStation ; sh:name "from" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:arrivalStation ; sh:name "to" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .
trips:BusTripShape a sh:NodeShape ; sh:targetClass schema:BusTrip ;
 sh:property [ sh:path schema:busNumber ; sh:name "number" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:departureTime ; sh:name "start" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:arrivalTime ; sh:name "end" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:departureBusStop ; sh:name "from" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:arrivalBusStop ; sh:name "to" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .
trips:LodgingBusinessShape a sh:NodeShape ; sh:targetClass schema:LodgingBusiness ;
 sh:property [ sh:path schema:name ; sh:name "title" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:address ; sh:name "address" ; sh:datatype xsd:string ; sh:maxCount 1 ] .
trips:FoodEstablishmentShape a sh:NodeShape ; sh:targetClass schema:FoodEstablishment ;
 sh:property [ sh:path schema:name ; sh:name "title" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:address ; sh:name "address" ; sh:datatype xsd:string ; sh:maxCount 1 ] .
trips:EventShape a sh:NodeShape ; sh:targetClass schema:Event ;
 sh:property [ sh:path schema:name ; sh:name "title" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:startDate ; sh:name "start" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:location ; sh:name "location" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .
trips:CarShape a sh:NodeShape ; sh:targetClass schema:Car ;
 sh:property [ sh:path schema:name ; sh:name "title" ; sh:datatype xsd:string ; sh:maxCount 1 ] .
trips:FlightReservationShape a sh:NodeShape ; sh:targetClass schema:FlightReservation ;
 sh:property [ sh:path schema:reservationNumber ; sh:name "reservationNumber" ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:reservationStatus ; sh:name "status" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:provider ; sh:name "provider" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:underName ; sh:name "underName" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:dateModified ; sh:name "modified" ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
 sh:property [ sh:path prov:wasDerivedFrom ; sh:name "source" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
 sh:property [ sh:path trips:trust ; sh:name "trust" ; sh:datatype xsd:string ; sh:in ( "verified" "unverified" ) ; sh:maxCount 1 ] ;
 sh:property [ sh:path schema:reservationFor ; sh:name "booking" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .
