{
  "name": "@jeswr/agent-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Approval-gated personal knowledge graph memory and scoped recall.",
  "type": "module",
  "license": "MIT",
  "x-authored-by": "Codex GPT-6.1-Sol",
  "sideEffects": false,
  "securityCritical": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "pnpm -w exec tsc -p packages/agent-memory/tsconfig.json",
    "typecheck": "pnpm -w exec tsc -p packages/agent-memory/tsconfig.json --noEmit && pnpm -w exec tsc -p packages/agent-memory/tsconfig.test.json",
    "lint": "pnpm -w exec biome check packages/agent-memory",
    "test": "pnpm -w exec vitest run --root packages/agent-memory"
  },
  "dependencies": {
    "@jeswr/agent-mandate": "workspace:*",
    "@jeswr/pkg-memory": "workspace:*",
    "@jeswr/rdf-engine": "workspace:*",
    "@jeswr/storage-client": "workspace:*",
    "n3": "^2.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/n3": "^1.26.1",
    "@solid/community-server": "7.2.0",
    "componentsjs": "5.5.1",
    "@jeswr/guarded-fetch": "workspace:*"
  }
}
