{
  "name": "@jeswr/solid-photos",
  "version": "0.1.0",
  "description": "Generated RDF models for photographs, EXIF, ordered albums and trash provenance.",
  "type": "module",
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/solid-sdk.git",
    "directory": "packages/solid-photos"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vocab": {
      "types": "./dist/vocab.d.ts",
      "import": "./dist/vocab.js"
    },
    "./photograph": {
      "types": "./dist/photograph.d.ts",
      "import": "./dist/photograph.js"
    },
    "./album": {
      "types": "./dist/album.d.ts",
      "import": "./dist/album.js"
    },
    "./exif": {
      "types": "./dist/exif.d.ts",
      "import": "./dist/exif.js"
    },
    "./trash": {
      "types": "./dist/trash.d.ts",
      "import": "./dist/trash.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    }
  },
  "files": [
    "dist",
    "codegen",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-generated.mjs",
    "codegen": "node node_modules/@jeswr/federation-codegen/dist/cli.js gen --ontology codegen/photos.ontology.ttl --shapes codegen/photos.shapes.ttl --config codegen/codegen.config.json --out src/generated",
    "lint": "biome check src scripts test codegen/codegen.config.json package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jeswr/model-runtime": "workspace:*",
    "@jeswr/rdf-serialize": "workspace:*",
    "@jeswr/suite-vocab": "workspace:*",
    "@rdfjs/wrapper": "0.34.0",
    "n3": "2.0.3"
  },
  "peerDependencies": {
    "@rdfjs/types": "2.0.1"
  },
  "devDependencies": {
    "@jeswr/federation-codegen": "workspace:*",
    "@jeswr/fetch-rdf": "workspace:*",
    "@rdfjs/types": "2.0.1",
    "@types/n3": "1.26.1",
    "@types/node": "^25.9.2",
    "@biomejs/biome": "^2.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  }
}
