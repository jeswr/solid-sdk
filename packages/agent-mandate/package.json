{
  "name": "@jeswr/agent-mandate",
  "version": "0.1.0",
  "private": true,
  "description": "VC-wrapped ODRL mandates, fail-closed policy evaluation and owner approvals.",
  "type": "module",
  "license": "MIT",
  "x-authored-by": "Codex GPT-6.1-Sol",
  "sideEffects": false,
  "securityCritical": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./sparq": {
      "types": "./dist/sparq.d.ts",
      "default": "./dist/sparq.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "pnpm -w exec tsc -p packages/agent-mandate/tsconfig.json",
    "typecheck": "pnpm -w exec tsc -p packages/agent-mandate/tsconfig.json --noEmit && pnpm -w exec tsc -p packages/agent-mandate/tsconfig.test.json",
    "lint": "pnpm -w exec biome check packages/agent-mandate",
    "test": "pnpm -w exec vitest run --root packages/agent-mandate --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.16.0"
  },
  "dependencies": {
    "@jeswr/agent-authz-verifier": "workspace:*",
    "@jeswr/fetch-rdf": "workspace:*",
    "@jeswr/solid-odrl": "workspace:*",
    "@jeswr/solid-vc": "workspace:*",
    "@rdfjs/wrapper": "^0.34.0",
    "jose": "^6.0.0",
    "n3": "^2.0.3"
  }
}
