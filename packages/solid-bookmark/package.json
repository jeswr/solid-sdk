{
  "name": "@jeswr/solid-bookmark",
  "version": "0.1.0",
  "description": "The RDF vocabulary + typed model for bookmarks / read-it-later (the data model for a Linkding\u2192Solid fork) \u2014 book:Bookmark over reused dereferenceable terms (schema.org / Dublin Core / SKOS) rooted in the suite core, plus the ontology TTL and SHACL shape that pin the contract.",
  "type": "module",
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/solid-bookmark.git"
  },
  "homepage": "https://github.com/jeswr/solid-bookmark#readme",
  "bugs": {
    "url": "https://github.com/jeswr/solid-bookmark/issues"
  },
  "keywords": [
    "solid",
    "rdf",
    "bookmark",
    "read-it-later",
    "linkding",
    "schema.org",
    "shacl",
    "vocabulary"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vocab": {
      "types": "./dist/vocab.d.ts",
      "import": "./dist/vocab.js"
    },
    "./shape": {
      "types": "./dist/shape.d.ts",
      "import": "./dist/shape.js"
    },
    "./bookmark.ttl": "./bookmark.ttl",
    "./bookmark.shacl.ttl": "./bookmark.shacl.ttl"
  },
  "files": [
    "dist",
    "bookmark.ttl",
    "bookmark.shacl.ttl",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-generated.mjs",
    "codegen": "federation-codegen gen --ontology bookmark.ttl --shapes bookmark.shacl.ttl --config codegen.config.json --out src/generated",
    "lint": "biome check src scripts test codegen.config.json package.json",
    "lint:fix": "biome check --write src scripts test codegen.config.json package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jeswr/fetch-rdf": "workspace:*",
    "@jeswr/model-runtime": "workspace:*",
    "@jeswr/rdf-serialize": "workspace:*",
    "@rdfjs/wrapper": "^0.34.0",
    "n3": "^2.0.3"
  },
  "peerDependencies": {
    "@rdfjs/types": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@jeswr/federation-codegen": "workspace:*",
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.1",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "@jeswr/rdf-engine": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
