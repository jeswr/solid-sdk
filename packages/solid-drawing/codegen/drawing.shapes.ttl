# AUTHORED-BY Codex (GPT-6.1 Sol)
# Package generation profile derived from sectors/drawing/drawing.shacl.ttl.
# Every difference from the sector is explicit:
# - Keep the package's https://jeswr.org/ns/drawing# IRIs, not the sector's
#   https://jeswr.org/ns/sectors/drawing# IRIs. Add the existing read-only w3id
#   Scene type and four predicate aliases via targetClass/alternativePath.
# - dct:title is OPTIONAL (omit sector minCount 1), maxCount 1 (sector unbounded),
#   preserving the package oracle. This is a sector relaxation, not a narrowing.
# - sceneDocument keeps Violation minCount/maxCount 1 and IRI node kind.
# - schemaVersion keeps xsd:string/maxCount 1/Warning; thumbnail keeps IRI/
#   maxCount 1/Info. Aliases share the same constraints.
# - Add the package's optional singleton dct:created/modified (xsd:dateTime),
#   draw:viewBackgroundColor (xsd:string), schema:about/prov:wasGeneratedBy (IRI).
# - Omit the sector prof:Profile/version metadata, labels and messages: the
#   published sector/package TTLs retain those, and they add no data constraints.
# Relative to the published drawing.shacl.ttl, schemaVersion and background are
# narrowed from arbitrary Literal to xsd:string: closed admission requires one
# concrete datatype. The facade carries other literal datatypes/language tags
# through a minimal typed lexical view, preserving the published model.
# No fields are omitted. Dates project as Date internally, strings in the facade.
# IRI escaping and union cardinality across aliases remain facade policy: runtime
# scheme guards normalize IRIs, and runtime singleton aliases are canonical-first.
# Both would change the existing drawing oracle. See README Exact divergences.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix draw: <https://jeswr.org/ns/drawing#> .
@prefix legacy: <https://w3id.org/jeswr/drawing#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
  sh:targetClass draw:Scene, legacy:Scene ;
  sh:property [
    sh:path [ sh:alternativePath ( draw:sceneDocument legacy:sceneDocument ) ] ;
    sh:name "sceneDocument" ; sh:nodeKind sh:IRI ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path dct:title ; sh:name "title" ; sh:datatype xsd:string ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path dct:created ; sh:name "created" ; sh:datatype xsd:dateTime ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path dct:modified ; sh:name "modified" ; sh:datatype xsd:dateTime ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path [ sh:alternativePath ( draw:schemaVersion legacy:schemaVersion ) ] ;
    sh:name "schemaVersion" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path [ sh:alternativePath ( draw:viewBackgroundColor legacy:viewBackgroundColor ) ] ;
    sh:name "viewBackgroundColor" ; sh:datatype xsd:string ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path [ sh:alternativePath ( draw:thumbnail legacy:thumbnail ) ] ;
    sh:name "thumbnail" ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; sh:severity sh:Info
  ] ;
  sh:property [
    sh:path schema:about ; sh:name "about" ; sh:nodeKind sh:IRI ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path prov:wasGeneratedBy ; sh:name "wasGeneratedBy" ; sh:nodeKind sh:IRI ; sh:maxCount 1
  ] .
