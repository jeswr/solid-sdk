@prefix ex: <https://example.org/scheduling/> .
@prefix sched: <https://w3id.org/jeswr/sectors/scheduling#> .
@prefix core: <https://w3id.org/jeswr/core#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:event a sched:CalendarEvent ;
    sched:summary "All-day event" ;
    sched:startTime "2026-11-01"^^xsd:date ;
    sched:endTime "2026-11-02"^^xsd:date ;
    sched:organizer ex:organizer .
ex:organizer a core:Agent .
ex:period core:validFrom "2026-11-01"^^xsd:date ;
    core:validUntil "2026-11-02"^^xsd:date .
