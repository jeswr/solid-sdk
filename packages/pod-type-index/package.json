{
  "$comment": "AUTHORED-BY Codex GPT-6.1-Sol",
  "name": "@jeswr/pod-type-index",
  "version": "0.1.0",
  "private": true,
  "description": "Type discovery and registration across Solid and LWS. Experimental, AI-agent-generated.",
  "type": "module",
  "sideEffects": false,
  "securityCritical": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-generated.mjs",
    "codegen": "node node_modules/@jeswr/federation-codegen/dist/cli.js gen --ontology codegen/type-index.ontology.ttl --shapes codegen/type-index.shapes.ttl --config codegen/codegen.config.json --out src/generated",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@jeswr/model-runtime": "workspace:*",
    "@jeswr/storage-capabilities": "workspace:*",
    "@jeswr/storage-client": "workspace:*",
    "@jeswr/suite-vocab": "workspace:*",
    "@rdfjs/wrapper": "^0.34.0",
    "n3": "^2.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@jeswr/federation-codegen": "workspace:*",
    "@types/n3": "^1.16.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
