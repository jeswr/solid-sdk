{
  "name": "@jeswr/y-solid",
  "version": "0.1.0",
  "description": "Yjs log persistence over StorageClient for Solid and LWS, with header ordering, safe compaction and optional notifications.",
  "type": "module",
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/y-solid.git"
  },
  "homepage": "https://github.com/jeswr/y-solid#readme",
  "bugs": {
    "url": "https://github.com/jeswr/y-solid/issues"
  },
  "keywords": [
    "yjs",
    "y-solid",
    "solid",
    "crdt",
    "collaborative",
    "persistence",
    "provider",
    "rdf"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jeswr/guarded-fetch": "workspace:*",
    "@jeswr/storage-client": "workspace:*",
    "@jeswr/pod-notifications": "workspace:*"
  },
  "peerDependencies": {
    "@rdfjs/types": "^2.0.1",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.1",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "yjs": "^13.6.0",
    "fast-check": "^4.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "$comment": "AUTHORED-BY Codex GPT-6.1-Sol"
}
