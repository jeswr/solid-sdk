{
  "manifestVersion": 1,
  "runtime": {
    "name": "@jeswr/model-runtime",
    "major": 0
  },
  "prefixes": {
    "legacy": "https://jeswr.org/ns/legacy#",
    "schema": "https://schema.org/",
    "dct": "http://purl.org/dc/terms/",
    "vcard": "http://www.w3.org/2006/vcard/ns#",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sh": "http://www.w3.org/ns/shacl#"
  },
  "entities": [
    {
      "name": "LegacyContact",
      "typeIris": [
        "https://jeswr.org/ns/legacy#LegacyContact"
      ],
      "subject": {
        "convention": "self"
      },
      "fields": [
        {
          "name": "displayName",
          "predicate": "http://www.w3.org/2006/vcard/ns#fn",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true,
            "minLength": 1
          }
        },
        {
          "name": "mode",
          "predicate": "http://www.w3.org/ns/odrl/2/action",
          "kind": "iri",
          "minCount": 1,
          "maxCount": 1,
          "in": [
            "http://www.w3.org/ns/odrl/2/read"
          ],
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "targets",
          "predicate": "http://www.w3.org/ns/odrl/2/target",
          "kind": "iri",
          "collection": "set",
          "minCount": 1,
          "maxCount": 100,
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "scope",
          "predicate": "https://jeswr.org/ns/legacy#scope",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "minCount": 1,
          "maxCount": 1,
          "in": [
            "whole-pod",
            "containers"
          ],
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "webId",
          "predicate": "https://schema.org/url",
          "kind": "iri",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true
          }
        }
      ]
    },
    {
      "name": "LegacyPlan",
      "typeIris": [
        "https://jeswr.org/ns/legacy#LegacyPlan"
      ],
      "subject": {
        "convention": "self"
      },
      "fields": [
        {
          "name": "created",
          "predicate": "http://purl.org/dc/terms/created",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#dateTime",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "owner",
          "predicate": "http://purl.org/dc/terms/creator",
          "kind": "iri",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "modified",
          "predicate": "http://purl.org/dc/terms/modified",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#dateTime",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "contactUrls",
          "predicate": "https://jeswr.org/ns/legacy#contact",
          "kind": "iri",
          "collection": "set",
          "minCount": 1,
          "maxCount": 50,
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "inactivityMonths",
          "predicate": "https://jeswr.org/ns/legacy#inactivityMonths",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#integer",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true,
            "minInclusive": 1,
            "maxInclusive": 120000
          }
        },
        {
          "name": "notifyMeBy",
          "predicate": "https://jeswr.org/ns/legacy#notifyMeBy",
          "kind": "literal",
          "collection": "set",
          "datatype": "http://www.w3.org/2001/XMLSchema#string",
          "minCount": 1,
          "maxCount": 2,
          "in": [
            "settings",
            "tray"
          ],
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "warningDays",
          "predicate": "https://jeswr.org/ns/legacy#warningDays",
          "kind": "literal",
          "collection": "set",
          "datatype": "http://www.w3.org/2001/XMLSchema#integer",
          "minCount": 1,
          "maxCount": 10,
          "guards": {
            "requiredFailClosed": true,
            "minInclusive": 1,
            "maxInclusive": 36600
          }
        },
        {
          "name": "storage",
          "predicate": "https://schema.org/contentUrl",
          "kind": "iri",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "enabled",
          "predicate": "https://schema.org/isActive",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#boolean",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true
          }
        },
        {
          "name": "lastActivity",
          "predicate": "https://schema.org/lastInteractionDate",
          "kind": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#dateTime",
          "minCount": 1,
          "maxCount": 1,
          "guards": {
            "requiredFailClosed": true
          }
        }
      ]
    }
  ]
}
