{
  "name": "@jeswr/agent-executor",
  "version": "0.1.0",
  "private": true,
  "description": "Single action enforcement point (experimental scaffold).",
  "type": "module",
  "license": "MIT",
  "x-authored-by": "Codex GPT-6.1-Sol",
  "sideEffects": false,
  "securityCritical": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "pnpm -w exec tsc -p packages/agent-executor/tsconfig.json",
    "typecheck": "pnpm -w exec tsc -p packages/agent-executor/tsconfig.json --noEmit && pnpm -w exec tsc -p packages/agent-executor/tsconfig.test.json",
    "lint": "pnpm -w exec biome check packages/agent-executor",
    "test": "pnpm -w exec vitest run --root packages/agent-executor --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10"
  }
}
