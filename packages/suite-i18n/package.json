  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@testing-library/react": "16.3.2",
    "jsdom": "29.1.1",
    "@biomejs/biome": "^2.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "4.1.10"
  }
