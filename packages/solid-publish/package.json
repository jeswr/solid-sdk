{
  "name": "@jeswr/solid-publish",
  "version": "0.1.0",
  "description": "Generated website and page models, safe static publishing and pod storage for Publish.",
  "type": "module",
  "license": "MIT",
  "author": "Jesse Wright",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "codegen",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-generated.mjs",
    "codegen": "node node_modules/@jeswr/federation-codegen/dist/cli.js gen --ontology codegen/publish.ttl --shapes codegen/publish.shacl.ttl --config codegen.config.json --out src/generated",
    "lint": "biome check src scripts test *.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@jeswr/fetch-rdf": "workspace:*",
    "@jeswr/model-runtime": "workspace:*",
    "@jeswr/pod-access": "workspace:*",
    "@jeswr/pod-type-index": "workspace:*",
    "@jeswr/storage-client": "workspace:*",
    "marked": "17.0.6",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@jeswr/federation-codegen": "workspace:*",
    "@types/node": "^25.9.2",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "@rdfjs/types": "2.0.1",
    "@types/n3": "1.26.1"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@rdfjs/types": "2.0.1"
  },
  "securityCritical": true
}
