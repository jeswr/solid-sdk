{
  "$comment": "AUTHORED-BY Codex GPT-6.1-Sol",
  "name": "@jeswr/pod-migrator",
  "version": "0.0.1",
  "securityCritical": true,
  "description": "Plan, review and copy Solid pods without widening access, using independent fenced connections.",
  "type": "module",
  "license": "MIT",
  "author": "Jesse Wright <63333554+jeswr@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/solid-sdk.git",
    "directory": "packages/pod-migrator"
  },
  "homepage": "https://github.com/jeswr/solid-sdk/tree/main/packages/pod-migrator#readme",
  "bugs": {
    "url": "https://github.com/jeswr/solid-sdk/issues"
  },
  "keywords": [
    "solid",
    "pod",
    "migration",
    "wac",
    "acp"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connections": {
      "types": "./dist/connections.d.ts",
      "import": "./dist/connections.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "docs/DESIGN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check src test vitest.config.ts",
    "lint:fix": "biome check --write src test vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:css": "node test/css/run.mjs"
  },
  "dependencies": {
    "@jeswr/fetch-rdf": "workspace:*",
    "@jeswr/guarded-fetch": "workspace:*",
    "@jeswr/pod-access": "workspace:*",
    "@jeswr/solid-auth-core": "workspace:*",
    "@jeswr/storage-capabilities": "workspace:*",
    "@rdfjs/wrapper": "0.34.0",
    "@solid/object": "0.6.0",
    "n3": "2.0.3"
  },
  "devDependencies": {
    "@rdfjs/types": "2.0.1",
    "@types/n3": "^1.26.1",
    "@types/node": "22.19.3",
    "@vitest/coverage-v8": "4.1.10",
    "@solid/community-server": "7.2.0",
    "@biomejs/biome": "^2.5.1",
    "typescript": "5.7.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
