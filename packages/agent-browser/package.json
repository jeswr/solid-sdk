{
  "name": "@jeswr/agent-browser",
  "version": "0.1.0",
  "private": true,
  "description": "RDF-only planner loop and approval-gated semantic agent browser demo.",
  "type": "module",
  "license": "MIT",
  "x-authored-by": "Codex GPT-6.1-Sol",
  "sideEffects": false,
  "securityCritical": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./demo": {
      "types": "./dist/demo.d.ts",
      "default": "./dist/demo.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "scripts"
  ],
  "scripts": {
    "lint": "pnpm -w exec biome check packages/agent-browser",
    "build": "pnpm -w exec tsc -p packages/agent-browser/tsconfig.json",
    "typecheck": "pnpm -w exec tsc -p packages/agent-browser/tsconfig.json --noEmit && pnpm -w exec tsc -p packages/agent-browser/tsconfig.test.json",
    "test": "pnpm -w exec vitest run --root packages/agent-browser",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@jeswr/site-executor": "workspace:*",
    "@jeswr/site-model": "workspace:*",
    "@jeswr/site-profiler": "workspace:*",
    "@jeswr/test-shop": "workspace:*",
    "@rdfjs/wrapper": "^0.34.0",
    "n3": "^2.1.1",
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/n3": "^1.26.1"
  }
}
